---
import '../styles/global.css';
import { jsonForScript } from '../lib/serialize.js';
import { SITE, u } from '../lib/site.js';
import { ogLocale, LOCALES, DEFAULT_LOCALE } from '../lib/i18n.js';
import idMessages from '../i18n/id.json' with { type: 'json' };
import enMessages from '../i18n/en.json' with { type: 'json' };

const {
  title,
  description,
  canonical,
  ogImage = SITE.ogImage,
  ogType = 'website',
  jsonLd = [],
  preloads = [],
  noindex = false,
  robots = 'index,follow',
  bodyClass = '',
} = Astro.props;
const user = Astro.locals.user;
const locale = Astro.locals.locale ?? DEFAULT_LOCALE;
const docTitle = title ?? (locale === 'en' ? SITE.titleEn : SITE.title);
const docDescription = description ?? (locale === 'en' ? SITE.descriptionEn : SITE.description);
const ogUrl = canonical ?? u(Astro.url.pathname);
---
<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={docDescription} />
  <meta name="referrer" content="no-referrer" />
  <meta name="robots" content={noindex ? 'noindex,nofollow' : robots} />
  <title>{docTitle}</title>

  <link rel="canonical" href={ogUrl} />
  <link rel="icon" href="/logo.png" type="image/png" />
  <link rel="apple-touch-icon" href="/logo.png" />

  {/* Open Graph + Twitter — link previews on WhatsApp, Instagram, FB, X */}
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={docTitle} />
  <meta property="og:description" content={docDescription} />
  <meta property="og:url" content={ogUrl} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content={ogLocale(locale)} />
  {LOCALES.filter(l => l !== locale).map(l => (
    <meta property="og:locale:alternate" content={ogLocale(l)} />
  ))}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={docTitle} />
  <meta name="twitter:description" content={docDescription} />
  <meta name="twitter:image" content={ogImage} />

  {/* Hreflang alternate links — cookie-based locale, same URL serves both locales */}
  {LOCALES.map(l => (
    <link rel="alternate" hreflang={l} href={u(Astro.url.pathname)} />
  ))}
  <link rel="alternate" hreflang="x-default" href={u(Astro.url.pathname)} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Spectral:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&display=swap"
    rel="stylesheet"
  />

  {jsonLd.map(obj => (
    <script type="application/ld+json" set:html={JSON.stringify(obj)} is:inline />
  ))}

  {/* Preload the LCP image so its download starts before CSS/JS are done. */}
  {preloads.map(h => (
    <link rel="preload" as="image" href={h} fetchpriority="high" />
  ))}

  {/* The signed-in user, handed to the client so it can render auth state on
      first paint. The session cookie itself is HTTP-only and never exposed.
      jsonForScript, not JSON.stringify: a name containing "</script>" would
      otherwise break out of this element. */}
  <script type="application/json" id="session-data" set:html={jsonForScript(user)} is:inline />
  <script type="application/json" id="locale-data" set:html={jsonForScript({ locale, messages: locale === 'en' ? enMessages : idMessages })} is:inline />
</head>
<body class:list={['bg-background text-text-dark', bodyClass]}>
  <slot />

  <div
    id="toast"
    role="status"
    aria-live="polite"
    class="fixed left-1/2 -translate-x-1/2 bottom-8 z-[99] opacity-0 translate-y-4 pointer-events-none
           bg-primary text-white text-sm font-heading px-5 py-3 rounded-full shadow-lg border border-accent/20"
  >
  </div>
</body>
</html>