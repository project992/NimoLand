---
/* /id/[...slug] catch-all:
   Sets locale cookie to "id", then redirects to the same path without prefix. */
export const prerender = false;

const slug = Astro.params.slug ?? '';
const rest = slug ? `/${slug}` : '/';
const qs = Astro.url.search;

Astro.cookies.set('nl_lang', 'id', {
  path: '/',
  maxAge: 60 * 60 * 24 * 365,
  sameSite: 'lax',
});

return Astro.redirect(rest + qs, 301);
---
