---
import Base from '../layouts/Base.astro';
import Shell from '../components/Shell.astro';
import { getRatings } from '../lib/ratings.js';
import { getVideos } from '../lib/videos.js';
import { organization } from '../lib/seo.js';
import { HERO_SLIDES } from '../lib/data.js';

export const prerender = false;

// Official ratings + promo videos, fetched once per request (cached in the
// libs) and handed to the client so JS-rendered cards show the same numbers.
const ratings = await getRatings();
const videos = await getVideos();
const heroImage = HERO_SLIDES[0].fb;
---
<Base
  title="Nimo Land Group — Embrace the Serene Breeze"
  description="Nimo Land Group — destinasi kebun teh, Sky Bridge 360°, Nimo Eye, destinasi & penginapan di seluruh Indonesia. Pesan tiket dan kamar online."
  canonical="/"
  jsonLd={[organization()]}
  preloads={[heroImage]}
>
  <Shell active="beranda" ratings={ratings} videos={videos} />
</Base>