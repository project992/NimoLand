---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const sections = [
  {
    id: 'umum',
    title: 'Umum',
    body: 'Dengan menggunakan situs resmi Nimo Land Group dan melakukan pemesanan, Anda dianggap telah membaca dan menyetujui Syarat &amp; Ketentuan ini. Istilah "kami" merujuk pada Nimo Land Group beserta seluruh unit usaha di bawahnya (antara lain Nimo Highland dan Nimo Eye).',
  },
  {
    id: 'pemesanan',
    title: 'Pemesanan Tiket & Kamar',
    body: 'Pemesanan dilakukan secara daring melalui situs ini dengan menggunakan akun terdaftar. Tanggal kedatangan pada pemesanan tiket paling cepat untuk kedatangan keesokan harinya. Jumlah tiket per pemesanan dan ketersediaan kamar mengikuti kebijakan manajemen yang berlaku saat itu.',
  },
  {
    id: 'pembayaran',
    title: 'Pembayaran',
    body: 'Pembayaran dilakukan di muka pada saat pemesanan. E-tiket akan diterbitkan setelah pembayaran terverifikasi dan berlaku sebagai bukti masuk yang sah. Harga yang tampil sudah termasuk atau belum termasuk pajak sesuai keterangan pada halaman tarif.',
  },
  {
    id: 'masa-berlaku',
    title: 'Masa Berlaku Tiket',
    body: 'Tiket berlaku maksimal 3 (tiga) hari sejak tanggal kedatangan yang dipilih saat pemesanan. Tiket yang tidak digunakan sampai masa berlaku berakhir dinyatakan hangus dan tidak dapat diubah jadwalnya.',
  },
  {
    id: 'larangan',
    title: 'Larangan & Penyalahgunaan',
    body: 'Tiket hanya dapat dipakai oleh pemegang sah sesuai data pemesan dan tidak boleh diperjualbelikan atau dialihkan kepada pihak lain. Penyalahgunaan tiket, termasuk pemalsuan atau penggandaan, menjadi tanggung jawab pemesan dan dapat mengakibatkan penolakan masuk tanpa pengembalian dana.',
  },
  {
    id: 'perubahan',
    title: 'Perubahan Informasi',
    body: 'Harga, jam operasional, jenis wahana, dan ketersediaan kamar dapat berubah sewaktu-waktu mengikuti kebijakan manajemen. Perubahan tidak serta-merta membatalkan pemesanan yang telah diselesaikan.',
  },
  {
    id: 'hukum',
    title: 'Hukum yang Berlaku',
    body: 'Syarat &amp; Ketentuan ini tunduk pada hukum Negara Republik Indonesia. (Nama badan hukum dan alamat lengkap tercantum pada bagian footer halaman ini.)',
  },
];
---
<Base
  title="Syarat & Ketentuan — Nimo Land Group"
  description="Syarat dan ketentuan pemesanan tiket dan hotel di Nimo Land Group."
>
  <Navbar />
  <main>
    <section class="bg-bark pt-32 pb-16 lg:pt-40 lg:pb-20">
      <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
        <p class="eyebrow text-white/70 mb-4">
          <span class="w-6 h-px bg-white/40"></span> Legal
        </p>
        <h1 class="font-heading font-bold text-white text-4xl sm:text-5xl lg:text-6xl leading-tight max-w-3xl">
          Syarat &amp; Ketentuan
        </h1>
        <p class="text-white/65 text-sm sm:text-base mt-5 max-w-xl">
          Ketentuan pemesanan tiket dan kamar di lingkungan Nimo Land Group.
          Terakhir diperbarui: <span class="text-warn">[ISI TANGGAL]</span>.
        </p>
      </div>
    </section>

    <section class="bg-canvas py-14 lg:py-20">
      <div class="max-w-3xl mx-auto px-5 sm:px-8 lg:px-10 space-y-9">
        {
          sections.map((s) => (
            <div id={`sk-${s.id}`}>
              <h2 class="font-heading font-semibold text-ink text-xl mb-2">{s.title}</h2>
              <p set:html={s.body} class="text-muted text-sm leading-relaxed" />
            </div>
          ))
        }
        <div class="bg-warn-tint border-l-4 border-warn rounded-r-lg p-5 text-sm text-ink/80 leading-relaxed">
          <strong class="font-heading">Draf internal.</strong> Halaman ini perlu direview tim legal/notaris
          sebelum ditampilkan ke publik. Bagian dan ketentuan yang mengikat (misalnya batas pembatalan,
          penalti, dan pajak) wajib disesuaikan dengan kebijakan resmi Nimo Land Group.
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <script src="../scripts/site.js"></script>
</Base>