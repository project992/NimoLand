---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const sections = [
  {
    id: 'pembatalan-tiket',
    title: 'Pembatalan Tiket Masuk',
    body: 'Tiket masuk yang dibeli secara online bersifat non-refundable (tidak dapat dikembalikan) kecuali ditentukan lain oleh promosi atau kebijakan khusus yang disebutkan saat transaksi. Pemesan dapat mengajukan penjadwalan ulang (reschedule) kedatangan dengan menyertakan kode pemesanan dan mengikuti ketentuan ketersediaan yang berlaku.',
  },
  {
    id: 'pembatalan-kamar',
    title: 'Pembatalan Reservasi Kamar / Hotel',
    body: 'Pembatalan reservasi kamar gratis apabila diajukan minimal 48 jam sebelum waktu check-in pada tanggal kedatangan. Pembatalan setelah batas waktu tersebut atau ketidakhadiran (no-show) pada hari kedatangan dikenakan biaya sebesar satu malam menginap. Ketentuan spesifik masing-masing properti dapat berbeda dan akan ditampilkan saat proses pemesanan.',
  },
  {
    id: 'proses-refund',
    title: 'Proses Pengembalian Dana',
    body: 'Pengembalian dana yang telah disetujui diproses dalam jangka waktu 7–14 hari kerja dan dikembalikan ke metode pembayaran asal. Pemesan akan menerima notifikasi beserta nomor referensi setelah pengembalian selesai diproses. Waktu tercerminnya dana bergantung pada bank atau penyedia pembayaran masing-masing.',
  },
  {
    id: 'penutupan',
    title: 'Penutupan Sementara Area / Wahana',
    body: 'Apabila sebuah wahana, destinasi, atau properti ditutup sementara karena cuaca ekstrem, pemeliharaan, atau kondisi lain di luar kendali manajemen, Nimo Land Group akan berupaya memberi tiket pengganti atau penjadwalan ulang yang setara. Keputusan ini diambil demi keselamatan dan kenyamanan pengunjung.',
  },
  {
    id: 'kontak',
    title: 'Mengajukan Pembatalan',
    body: 'Pengajuan pembatalan atau penjadwalan ulang dilakukan dengan menyertakan kode pemesanan (booking code) ke official@nimoenterprise.com atau melalui WhatsApp reservasi 0821-6402-2221 beserta dokumen pendukung jika diperlukan. Tim kami akan memproses permintaan Anda secepatnya.',
  },
];
---
<Base
  title="Pembatalan & Refund — Nimo Land Group"
  description="Kebijakan pembatalan dan pengembalian dana pemesanan di Nimo Land Group."
>
  <Navbar />
  <main>
    <section class="bg-bark pt-32 pb-16 lg:pt-40 lg:pb-20">
      <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
        <p class="eyebrow text-white/70 mb-4">
          <span class="w-6 h-px bg-white/40"></span> Legal
        </p>
        <h1 class="font-heading font-bold text-white text-4xl sm:text-5xl lg:text-6xl leading-tight max-w-3xl">
          Pembatalan &amp; Refund
        </h1>
        <p class="text-white/65 text-sm sm:text-base mt-5 max-w-xl">
          Ketentuan pembatalan dan pengembalian dana pemesanan di Nimo Land Group.
          Terakhir diperbarui: <span class="text-warn">1 September 2026</span>.
        </p>
      </div>
    </section>

    <section class="bg-canvas py-14 lg:py-20">
      <div class="max-w-3xl mx-auto px-5 sm:px-8 lg:px-10 space-y-9">
        {
          sections.map((s) => (
            <div id={`ref-${s.id}`}>
              <h2 class="font-heading font-semibold text-ink text-xl mb-2">{s.title}</h2>
              <p class="text-muted text-sm leading-relaxed">{s.body}</p>
            </div>
          ))
        }
        <div class="bg-info-tint border-l-4 border-info rounded-r-lg p-5 text-sm text-ink/80 leading-relaxed">
          <strong class="font-heading">Perlu bantuan?</strong> Tim reservasi kami siap membantu
          pembatalan dan penjadwalan ulang. Hubungi official@nimoenterprise.com atau
           WhatsApp 0821-6402-2221 dengan menyertakan kode pemesanan Anda.
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <script src="../scripts/site.js"></script>
</Base>