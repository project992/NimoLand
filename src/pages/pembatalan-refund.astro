---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const sections = [
  {
    id: 'pembatalan-tiket',
    title: 'Pembatalan Tiket Masuk',
    body: '[ISI: apakah tiket masuk dapat dibatalkan, batas waktu pembatalan, dan ketentuan pengembalian dana tiket (misal: full refund jika dibatalkan minimal H-1, atau non-refundable).]',
  },
  {
    id: 'pembatalan-kamar',
    title: 'Pembatalan Reservasi Kamar / Hotel',
    body: '[ISI: kebijakan pembatalan masing-masing hotel, termasuk batas waktu bebas biaya, biaya pembatalan, dan kebijakan no-show pada hari kedatangan.]',
  },
  {
    id: 'proses-refund',
    title: 'Proses Pengembalian Dana',
    body: '[ISI: jangka waktu pemrosesan refund, metode pengembalian (dana kembalikan ke metode pembayaran asal), dan nomor referensi yang diterima pemesan.]',
  },
  {
    id: 'penutupan',
    title: 'Penutupan Sementara Area / Wahana',
    body: '[ISI: kebijakan saat wahana atau destinasi ditutup sementara karena cuaca, pemeliharaan, atau kondisi lain yang di luar kendali manajemen.]',
  },
  {
    id: 'kontak',
    title: 'Mengajukan Pembatalan',
    body: 'Pembatalan diajukan dengan menyertakan kode pemesanan (booking code) ke official@nimoenterprise.com atau melalui kanal resmi lainnya yang kami sediakan.',
  },
];
---
<Base
  title="Pembatalan & Refund — Nimo Land Group"
  description="Kebijakan pembatalan dan pengembalian dana pemesanan di Nimo Land Group."
>
  <Navbar />
  <main>
    <section class="bg-bark pt-32 pb-16 lg:pt-40 lg:pb-20">
      <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
        <p class="eyebrow text-white/70 mb-4">
          <span class="w-6 h-px bg-white/40"></span> Legal
        </p>
        <h1 class="font-heading font-bold text-white text-4xl sm:text-5xl lg:text-6xl leading-tight max-w-3xl">
          Pembatalan &amp; Refund
        </h1>
        <p class="text-white/65 text-sm sm:text-base mt-5 max-w-xl">
          Ketentuan pembatalan dan pengembalian dana pemesanan di Nimo Land Group.
          Terakhir diperbarui: <span class="text-warn">[ISI TANGGAL]</span>.
        </p>
      </div>
    </section>

    <section class="bg-canvas py-14 lg:py-20">
      <div class="max-w-3xl mx-auto px-5 sm:px-8 lg:px-10 space-y-9">
        {
          sections.map((s) => (
            <div id={`ref-${s.id}`}>
              <h2 class="font-heading font-semibold text-ink text-xl mb-2">{s.title}</h2>
              <p class="text-muted text-sm leading-relaxed">{s.body}</p>
            </div>
          ))
        }
        <div class="bg-warn-tint border-l-4 border-warn rounded-r-lg p-5 text-sm text-ink/80 leading-relaxed">
          <strong class="font-heading">Belum ditetapkan.</strong> Nimo Land Group belum memublikasikan
          kebijakan pembatalan &amp; refund resmi. Seluruh bagian di atas masih berupa placeholder
          <em>— isi bersama tim operasional dan finance</em> sebelum halaman ini dipublikasikan.
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <script src="../scripts/site.js"></script>
</Base>