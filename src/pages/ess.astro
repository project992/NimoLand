---
import Base from '../layouts/Base.astro';
import Shell from '../components/Shell.astro';
import { getRatings } from '../lib/ratings.js';
import { getVideos } from '../lib/videos.js';

export const prerender = false;

/* Portal ESS — route terpisah, TIDAK ditautkan dari footer publik.
   Memakai Shell supaya app.js (yang berisi seluruh logika ESS) ikut dimuat;
   chrome publik disembunyikan lewat class body "ess-only". Karyawan login di
   sini; di /ess muncul form login (atau dashboard bila sesi karyawan aktif). */
const [ratings, videos] = await Promise.all([
  getRatings().catch(() => ({})),
  getVideos().catch(() => ({})),
]);
const employee = Astro.locals.isEmployee;
---
<Base
  title="Portal ESS — Nimo Land Group"
  description="Portal Karyawan Nimo Land Group."
  noindex
  bodyClass="ess-only"
>
  <div id="essStandalone" />
  <Shell active="beranda" ratings={ratings} videos={videos} />
</Base>