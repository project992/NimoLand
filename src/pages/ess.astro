---
import Base from '../layouts/Base.astro';
import EssPortal from '../components/ess/EssPortal.astro';
import { getVideos } from '../lib/videos.js';
import { jsonForScript } from '../lib/serialize.js';

export const prerender = false;

/* Portal ESS Internal — route terpisah & aman untuk operasional karyawan Nimo Land Group.
   Terisolasi sepenuhnya dari halaman publik corporate (tidak memuat Shell publik / app.js publik). */
const videos = await getVideos().catch(() => ({}));
---
<Base
  title="Portal ESS Internal — Nimo Land Group"
  description="Portal Karyawan Internal Nimo Land Group."
  noindex
  bodyClass="bg-background"
>
  <script type="application/json" id="videos-data" set:html={jsonForScript(videos)} is:inline />
  <EssPortal standalone={true} />
  <script src="../scripts/ess.js"></script>
</Base>