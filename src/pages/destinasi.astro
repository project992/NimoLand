---
import Base from '../layouts/Base.astro';
import Shell from '../components/Shell.astro';
import { getRatings } from '../lib/ratings.js';
import { breadcrumbs, organization } from '../lib/seo.js';

const locale = Astro.locals.locale ?? 'id';
const ratings = await getRatings();

const jsonLd = [
  organization(),
  breadcrumbs([{ name: locale === 'en' ? 'Home' : 'Beranda', path: '/' }, { name: locale === 'en' ? 'Destinations' : 'Destinasi', path: '/destinasi' }]),
];
---
<Base
  title={locale === 'en' ? 'Destinations — Nimo Land Group' : 'Destinasi — Nimo Land Group'}
  description={locale === 'en' ? 'All Nimo Land Group destinations: Nimo Highland tea plantation, Nimo Eye, water parks, and more across Indonesia.' : 'Semua destinasi Nimo Land Group: kebun teh Nimo Highland, Nimo Eye, taman air, dan destinasi lain di seluruh Indonesia.'}
  canonical="/destinasi"
  jsonLd={jsonLd}
>
  <Shell active="destinations" ratings={ratings} />
</Base>
