---
import Base from '../layouts/Base.astro';
import AuthShell from '../components/AuthShell.astro';
import UserPlus from '@lucide/astro/icons/user-plus';
import { safeNext } from '../lib/redirect.js';
import { t } from '../lib/i18n.js';

export const prerender = false;

const locale = Astro.locals.locale ?? 'id';
const _t = (k) => t(k, locale);

const next = safeNext(Astro.url.searchParams.get('next'));
---
<Base title={_t('auth.registerPageTitle')} description={_t('auth.registerPageDesc')} noindex>
  <AuthShell
    title={_t('auth.registerTitle')}
    subtitle={_t('auth.registerSubtitle')}
  >
    <form id="registerForm" class="mt-8" novalidate>
      <input type="hidden" id="nextUrl" value={next} />

      <label for="name" class="label">{_t('auth.registerName')}</label>
      <input type="text" id="name" name="name" autocomplete="name" required maxlength="80"
             placeholder={_t('auth.registerNamePh')} class="field mb-4" />

      <label for="email" class="label">{_t('auth.registerEmail')}</label>
      <input type="email" id="email" name="email" autocomplete="email" required
             placeholder="nama@email.com" class="field mb-4" />

      <label for="phone" class="label">
        {_t('auth.registerPhone')} <span class="font-normal text-muted">({_t('auth.registerPhoneOptional')})</span>
      </label>
      <input type="tel" id="phone" name="phone" autocomplete="tel"
             placeholder={_t('auth.registerPhonePh')} class="field mb-4" />

      <label for="password" class="label">{_t('auth.registerPassword')}</label>
      <input type="password" id="password" name="password" autocomplete="new-password" required
             minlength="8" placeholder={_t('auth.registerPasswordPh')} class="field mb-1.5" />
      <p class="text-xs text-muted mb-4">{_t('auth.registerPasswordMin')}</p>

      <p id="registerError" class="hidden note-error mb-4" role="alert"></p>

      <button type="submit" id="registerBtn" class="btn-primary w-full py-3.5">
        <UserPlus class="w-4 h-4" /> {_t('auth.registerBtn')}
      </button>
    </form>

    <p class="text-sm text-muted text-center mt-6">
      {_t('auth.hasAccount')}
      <a href={`/login?next=${encodeURIComponent(next)}`} class="font-heading font-semibold text-sage-deep border-b border-sage pb-0.5">
        {_t('auth.loginHere')}
      </a>
    </p>
  </AuthShell>

  <script define:vars={{ t_name: _t('auth.registerErrorName'), t_email: _t('auth.registerErrorEmail'), t_pass: _t('auth.registerErrorPassword'), t_loading: _t('auth.registerLoading'), t_conn: _t('auth.registerErrorConn'), t_default: _t('auth.registerErrorDefault') }}>
    const form = document.getElementById('registerForm');
    const btn = document.getElementById('registerBtn');
    const err = document.getElementById('registerError');
    const original = btn.innerHTML;

    form.addEventListener('submit', async e => {
      e.preventDefault();
      err.classList.add('hidden');

      const payload = {
        name: document.getElementById('name').value.trim(),
        email: document.getElementById('email').value.trim(),
        phone: document.getElementById('phone').value.trim(),
        password: document.getElementById('password').value,
      };

      if (payload.name.length < 3) return fail(t_name);
      if (!payload.email) return fail(t_email);
      if (payload.password.length < 8) return fail(t_pass);

      btn.disabled = true;
      btn.textContent = t_loading;

      let res, data;
      try {
        res = await fetch('/api/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify(payload),
        });
        data = await res.json();
      } catch {
        return fail(t_conn);
      }

      if (!res.ok) return fail(data?.error ?? t_default);

      window.location.href = document.getElementById('nextUrl').value || '/';
    });

    function fail(message) {
      btn.disabled = false;
      btn.innerHTML = original;
      err.textContent = message;
      err.classList.remove('hidden');
    }
  </script>
</Base>
