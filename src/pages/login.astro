---
import Base from '../layouts/Base.astro';
import AuthShell from '../components/AuthShell.astro';
import LogIn from '@lucide/astro/icons/log-in';
import { safeNext } from '../lib/redirect.js';

export const prerender = false;

// Where to send the visitor after a successful login. Sanitised so a crafted
// ?next= can't bounce them to another site.
const next = safeNext(Astro.url.searchParams.get('next'));
const cameFromGate = next !== '/';
---
<Base title="Masuk — Nimo Land Group" description="Masuk ke akun Nimo Land Group untuk memesan tiket dan kamar." noindex>
  <AuthShell
    title="Masuk ke akun Anda"
    subtitle={cameFromGate
      ? 'Setelah masuk, Anda akan kembali ke halaman pemesanan yang tadi dibuka.'
      : 'Masuk untuk memesan tiket, menyimpan e-tiket, dan melihat riwayat pesanan.'}
  >
    <form id="loginForm" class="mt-8" novalidate>
      <input type="hidden" id="nextUrl" value={next} />

      <label for="email" class="label">Email</label>
      <input type="email" id="email" name="email" autocomplete="email" required
             placeholder="nama@email.com" class="field mb-4" />

      <label for="password" class="label">Password</label>
      <input type="password" id="password" name="password" autocomplete="current-password" required
             placeholder="Masukkan password" class="field mb-4" />

      <p id="loginError" class="hidden note-error mb-4" role="alert"></p>

      <button type="submit" id="loginBtn" class="btn-primary w-full py-3.5">
        <LogIn class="w-4 h-4" /> Masuk
      </button>
    </form>

    <p class="text-sm text-muted text-center mt-6">
      Belum punya akun?
      <a href={`/register?next=${encodeURIComponent(next)}`} class="font-heading font-semibold text-sage-deep border-b border-sage pb-0.5">
        Daftar sekarang
      </a>
    </p>
  </AuthShell>

  <script>
    const form = document.getElementById('loginForm');
    const btn = document.getElementById('loginBtn');
    const err = document.getElementById('loginError');
    const original = btn.innerHTML;

    form.addEventListener('submit', async e => {
      e.preventDefault();
      err.classList.add('hidden');

      const email = document.getElementById('email').value.trim();
      const password = document.getElementById('password').value;
      const next = document.getElementById('nextUrl').value;

      if (!email || !password) {
        err.textContent = 'Email dan password wajib diisi.';
        err.classList.remove('hidden');
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Memeriksa…';

      let res, data;
      try {
        res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ email, password, next }),
        });
        data = await res.json();
      } catch {
        btn.disabled = false;
        btn.innerHTML = original;
        err.textContent = 'Tidak dapat menghubungi server. Periksa koneksi Anda.';
        err.classList.remove('hidden');
        return;
      }

      if (!res.ok) {
        btn.disabled = false;
        btn.innerHTML = original;
        err.textContent = data?.error ?? 'Tidak dapat masuk. Coba lagi.';
        err.classList.remove('hidden');
        return;
      }

      // The session cookie is already set. A full navigation (not history.push)
      // so every server-rendered fragment re-renders with the session applied.
      window.location.href = data.next || next || '/';
    });
  </script>
</Base>
