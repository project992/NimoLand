---
import Base from '../layouts/Base.astro';
import AuthShell from '../components/AuthShell.astro';
import LogIn from '@lucide/astro/icons/log-in';
import { safeNext } from '../lib/redirect.js';
import { t } from '../lib/i18n.js';

export const prerender = false;

const locale = Astro.locals.locale ?? 'id';
const _t = (k) => t(k, locale);

const next = safeNext(Astro.url.searchParams.get('next'));
const cameFromGate = next !== '/';
---
<Base title={_t('auth.loginPageTitle')} description={_t('auth.loginPageDesc')} noindex>
  <AuthShell
    title={_t('auth.loginTitle')}
    subtitle={cameFromGate
      ? _t('auth.loginSubtitleGate')
      : _t('auth.loginSubtitle')}
  >
    <form id="loginForm" class="mt-8" novalidate>
      <input type="hidden" id="nextUrl" value={next} />

      <label for="email" class="label">{_t('auth.fieldEmail')}</label>
      <input type="email" id="email" name="email" autocomplete="email" required
             placeholder="nama@email.com" class="field mb-4" />

      <label for="password" class="label">{_t('auth.fieldPassword')}</label>
      <input type="password" id="password" name="password" autocomplete="current-password" required
             placeholder={_t('auth.fieldPasswordPh')} class="field mb-4" />

      <p id="loginError" class="hidden note-error mb-4" role="alert"></p>

      <button type="submit" id="loginBtn" class="btn-primary w-full py-3.5">
        <LogIn class="w-4 h-4" /> {_t('auth.loginBtn')}
      </button>
    </form>

    <p class="text-sm text-muted text-center mt-6">
      {_t('auth.noAccount')}
      <a href={`/register?next=${encodeURIComponent(next)}`} class="font-heading font-semibold text-sage-deep border-b border-sage pb-0.5">
        {_t('auth.registerNow')}
      </a>
    </p>
  </AuthShell>

  <script define:vars={{ t_empty: _t('auth.loginErrorEmpty'), t_loading: _t('auth.loginLoading'), t_conn: _t('auth.loginErrorConn'), t_default: _t('auth.loginErrorDefault') }}>
    const form = document.getElementById('loginForm');
    const btn = document.getElementById('loginBtn');
    const err = document.getElementById('loginError');
    const original = btn.innerHTML;

    form.addEventListener('submit', async e => {
      e.preventDefault();
      err.classList.add('hidden');

      const email = document.getElementById('email').value.trim();
      const password = document.getElementById('password').value;
      const next = document.getElementById('nextUrl').value;

      if (!email || !password) {
        err.textContent = t_empty;
        err.classList.remove('hidden');
        return;
      }

      btn.disabled = true;
      btn.textContent = t_loading;

      let res, data;
      try {
        res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ email, password, next }),
        });
        data = await res.json();
      } catch {
        btn.disabled = false;
        btn.innerHTML = original;
        err.textContent = t_conn;
        err.classList.remove('hidden');
        return;
      }

      if (!res.ok) {
        btn.disabled = false;
        btn.innerHTML = original;
        err.textContent = data?.error ?? t_default;
        err.classList.remove('hidden');
        return;
      }

      window.location.href = data.next || next || '/';
    });
  </script>
</Base>
