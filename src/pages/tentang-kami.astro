---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="About Us — Nimo Land Group"
  description="Leading Integrated Tourism and Hospitality Group in Indonesia."
>
  <Navbar />
  
  <main class="pt-24 lg:pt-32">
    <!-- ========================================================================== -->
    <!-- 2. SECTION: About (3 Bagian + Vision Statement)                            -->
    <!-- ========================================================================== -->
    <section id="about-corporate" class="bg-stone-50 text-stone-900 py-16 lg:py-28">
      <div class="max-w-7xl mx-auto px-6 lg:px-12 space-y-24 lg:space-y-36">

        <!-- Vision Statement Banner (Standalone Highlight) -->
        <div class="max-w-4xl mx-auto text-center py-12 px-6 border-y border-stone-300">
          <p class="text-xs uppercase tracking-[0.25em] text-stone-500 font-semibold mb-6">
            Corporate Vision
          </p>
          <blockquote class="font-serif italic text-2xl sm:text-3xl lg:text-4xl text-stone-900 leading-snug font-normal">
            “To become one of Indonesia’s leading integrated tourism and hospitality groups.”
          </blockquote>
        </div>

        <!-- Part 1: Who We Are (Image Right) -->
        <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">
          <div class="lg:col-span-5 space-y-6">
            <p class="text-xs uppercase tracking-[0.25em] text-stone-500 font-semibold">
              01 / Identity
            </p>
            <h2 class="font-heading font-bold text-3xl sm:text-4xl text-stone-900 leading-tight">
              Who We Are
            </h2>
            <p class="text-stone-600 text-base sm:text-lg leading-relaxed font-light">
              Nimo Land Group is an integrated national tourism and hospitality holding enterprise. We develop and manage modern landmark destinations and nature-inspired resorts across Indonesia. Our operations bridge sustainable eco-tourism with long-term regional economic empowerment.
            </p>
          </div>
          <div class="lg:col-span-7">
            <div class="aspect-[16/10] overflow-hidden bg-stone-200 rounded-2xl shadow-lg">
              <!-- IMG: foto-who-we-are.jpg -->
              <img src="/brand/nimo-highland/nh-01.jpg" alt="Nimo Group Destination Overview" class="w-full h-full object-cover grayscale-[20%] hover:grayscale-0 transition duration-700 ease-out" loading="eager" />
            </div>
          </div>
        </div>

        <!-- Part 2: What We Build (Image Left) -->
        <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">
          <div class="lg:col-span-7 order-2 lg:order-1">
            <div class="aspect-[16/10] overflow-hidden bg-stone-200 rounded-2xl shadow-lg">
              <!-- IMG: foto-what-we-build.jpg -->
              <img src="/brand/nimo-tea-resort/nimo-tea-resort-01.png" alt="Nimo Hospitality & Theme Parks" class="w-full h-full object-cover grayscale-[20%] hover:grayscale-0 transition duration-700 ease-out" loading="lazy" />
            </div>
          </div>
          <div class="lg:col-span-5 order-1 lg:order-2 space-y-6">
            <p class="text-xs uppercase tracking-[0.25em] text-stone-500 font-semibold">
              02 / Portfolio
            </p>
            <h2 class="font-heading font-bold text-3xl sm:text-4xl text-stone-900 leading-tight">
              What We Build
            </h2>
            <p class="text-stone-600 text-base sm:text-lg leading-relaxed font-light">
              We engineer high-capacity iconic theme parks, record-breaking scenic attractions, and signature accommodation clusters. Each property is crafted to preserve native landscapes while delivering institutional-grade hospitality infrastructure.
            </p>
          </div>
        </div>

        <!-- Part 3: Where We're Going (Image Right) -->
        <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">
          <div class="lg:col-span-5 space-y-6">
            <p class="text-xs uppercase tracking-[0.25em] text-stone-500 font-semibold">
              03 / Horizon
            </p>
            <h2 class="font-heading font-bold text-3xl sm:text-4xl text-stone-900 leading-tight">
              Where We’re Going
            </h2>
            <p class="text-stone-600 text-base sm:text-lg leading-relaxed font-light">
              We are expanding across national Super Priority Tourism Destinations, including Lake Toba and Bali. By forging institutional collaborations with government entities, landowners, and regional communities, we build resilient tourism ecosystems for the next generation.
            </p>
          </div>
          <div class="lg:col-span-7">
            <div class="aspect-[16/10] overflow-hidden bg-stone-200 rounded-2xl shadow-lg">
              <!-- IMG: foto-where-were-going.jpg -->
              <img src="/brand/pinaru-park/pinaru-park-01.png" alt="Future Expansion Pipeline" class="w-full h-full object-cover grayscale-[20%] hover:grayscale-0 transition duration-700 ease-out" loading="lazy" />
            </div>
          </div>
        </div>

      </div>
    </section>
  </main>

  <Footer />
</Base>