---
import Base from '../layouts/Base.astro';
import Shell from '../components/Shell.astro';
import { getRatings } from '../lib/ratings.js';
import { breadcrumbs, organization } from '../lib/seo.js';

const ratings = await getRatings();

const jsonLd = [
  organization(),
  breadcrumbs([{ name: 'Beranda', path: '/' }, { name: 'Penginapan', path: '/penginapan' }]),
];
---
<Base
  title="Hotels & Penginapan — Nimo Land Group"
  description="Pilihan penginapan Nimo Land Group: Nimo Tea Resort, Nimo Resort Ciater, Glamping Nimoza, Savia Hotel & Resort, dan New Dgyp Resort Ciater."
  canonical="/penginapan"
  jsonLd={jsonLd}
>
  <Shell active="hotels" ratings={ratings} />
</Base>