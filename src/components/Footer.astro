---
// SECTION 4: Footer corporate
const currentYear = new Date().getFullYear();
---
<footer class="bg-[#0D1913] text-[#E6E1D8] pt-16 pb-12 border-t-2 border-accent text-sm" style="background-color: #0D1913; color: #E6E1D8;">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    
    <!-- Top Row: Brand & Main Navigation -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-8 pb-10 border-b border-white/15">
      <div>
        <h3 class="font-heading font-bold text-2xl text-white tracking-wide">
          NIMO LAND GROUP
        </h3>
        <p class="text-xs text-accent uppercase tracking-widest mt-1 font-semibold">
          Integrated Tourism &amp; Hospitality
        </p>
      </div>

      <!-- Navigation Links (High-Contrast & Explicit Text Colors) -->
      <nav class="flex flex-wrap items-center gap-x-6 sm:gap-x-8 gap-y-3 text-xs tracking-wider uppercase font-semibold text-white">
        <a href="/destinasi" data-route="destinations" class="text-white hover:text-accent hover:underline transition-colors">Destinations</a>
        <a href="/penginapan" data-route="hotels" class="text-white hover:text-accent hover:underline transition-colors">Hotels &amp; Resorts</a>
        <a href="/tentang-kami" class="text-white hover:text-accent hover:underline transition-colors">About Us</a>
        <a href="/kontak#partnership" data-route="kontak" class="text-white hover:text-accent hover:underline transition-colors">Partnership</a>
        <a href="/#recognition-media" data-route="beranda" class="text-white hover:text-accent hover:underline transition-colors">Media &amp; News</a>
        <a href="/karir" class="text-white hover:text-accent hover:underline transition-colors">Careers</a>
        <a href="/kontak" data-route="kontak" class="text-white hover:text-accent hover:underline transition-colors">Contact</a>
      </nav>
    </div>

    <!-- Middle Row: Offices & Social Links -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 py-12 border-b border-white/15">
      
      <!-- Bandung Office -->
      <div class="md:col-span-4 space-y-2">
        <p class="text-xs uppercase tracking-widest text-accent font-bold">Bandung Office</p>
        <p class="text-[#F0ECE1] text-xs sm:text-sm font-normal leading-relaxed">
          Buahbatu Square Blk. A No.09, Cipagalo, Bojongsoang, Kabupaten Bandung 40267
        </p>
      </div>

      <!-- Jakarta Office -->
      <div class="md:col-span-4 space-y-2">
        <p class="text-xs uppercase tracking-widest text-accent font-bold">Jakarta Office</p>
        <p class="text-[#F0ECE1] text-xs sm:text-sm font-normal leading-relaxed">
          Sequis Center Lt. 8 Kav 814, Jl. Jendral Sudirman No. 71, Senayan, Jakarta Selatan
        </p>
      </div>

      <!-- Social Media Outlines / Badges -->
      <div class="md:col-span-4 flex flex-wrap md:justify-end items-start gap-3 pt-2 md:pt-0">
        <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" 
           class="text-xs uppercase tracking-wider text-white border border-white/30 hover:border-accent hover:bg-accent hover:text-text-dark px-3.5 py-1.5 rounded-full transition-all font-semibold shadow-sm">
          Instagram
        </a>
        <a href="https://tiktok.com" target="_blank" rel="noopener noreferrer" 
           class="text-xs uppercase tracking-wider text-white border border-white/30 hover:border-accent hover:bg-accent hover:text-text-dark px-3.5 py-1.5 rounded-full transition-all font-semibold shadow-sm">
          TikTok
        </a>
        <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" 
           class="text-xs uppercase tracking-wider text-white border border-white/30 hover:border-accent hover:bg-accent hover:text-text-dark px-3.5 py-1.5 rounded-full transition-all font-semibold shadow-sm">
          YouTube
        </a>
        <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" 
           class="text-xs uppercase tracking-wider text-white border border-white/30 hover:border-accent hover:bg-accent hover:text-text-dark px-3.5 py-1.5 rounded-full transition-all font-semibold shadow-sm">
          LinkedIn
        </a>
      </div>
    </div>

    <!-- Bottom Row: Legal & Copyright -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#B8B2A7]">
      <p>&copy; {currentYear} Nimo Land Group. All rights reserved.</p>
      <div class="flex gap-6 font-medium">
        <a href="/kebijakan-privasi" class="text-[#D4CEBF] hover:text-accent underline transition-colors">Privacy Policy</a>
        <a href="/syarat-ketentuan" class="text-[#D4CEBF] hover:text-accent underline transition-colors">Terms of Service</a>
      </div>
    </div>

  </div>
</footer>
