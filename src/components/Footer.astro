---
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Building2 from '@lucide/astro/icons/building-2';
import MapPin from '@lucide/astro/icons/map-pin';
import Mail from '@lucide/astro/icons/mail';
import { COMPANY } from '../lib/data.js';

const locale = Astro.locals.locale ?? 'id';
---
<footer class="bg-primary pt-16 pb-10 border-t border-white/10 text-white">
  <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
    
    <!-- Main Footer Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-12 gap-10 pb-12 border-b border-white/10">
      
      <!-- Brand & Holding Entity (Col 4) -->
      <div class="lg:col-span-4">
        <a href="/" data-route="beranda" class="flex items-center gap-2 font-heading font-bold text-white text-2xl mb-4">
          NIMO <span class="text-accent text-sm font-semibold tracking-widest uppercase">Land Group</span>
        </a>
        <p class="text-white/75 text-xs sm:text-sm leading-relaxed mb-5 max-w-sm">
          {locale === 'en'
            ? 'Developing world-class destinations and resorts across Indonesia while creating sustainable economic impact for local communities.'
            : 'Kelompok usaha pariwisata terintegrasi nasional yang berfokus pada pengembangan destinasi ikonik, perhotelan ramah lingkungan, dan dampak sosial berkelanjutan.'}
        </p>
        <div class="p-3.5 rounded-xl bg-white/5 border border-white/10 inline-block">
          <p class="text-[10px] font-heading uppercase tracking-widest text-accent font-semibold">Legal Entity</p>
          <p class="text-xs font-semibold text-white/90">{COMPANY.legalName}</p>
        </div>
      </div>

      <!-- Navigation Links (Col 3) -->
      <div class="lg:col-span-3">
        <p class="font-heading text-accent text-xs font-semibold uppercase tracking-widest mb-4">
          {locale === 'en' ? 'Quick Links' : 'Navigasi Korporat'}
        </p>
        <ul class="space-y-2.5 text-xs sm:text-sm text-white/80">
          <li><a href="/destinasi" data-route="destinations" class="hover:text-accent transition-colors">{locale === 'en' ? 'Destinations' : 'Destinasi'}</a></li>
          <li><a href="/penginapan" data-route="hotels" class="hover:text-accent transition-colors">{locale === 'en' ? 'Hotels & Resorts' : 'Hotels & Resorts'}</a></li>
          <li><a href="/tentang-kami" class="hover:text-accent transition-colors">{locale === 'en' ? 'About Us' : 'Tentang Kami'}</a></li>
          <li><a href="/#partnership" class="hover:text-accent transition-colors">{locale === 'en' ? 'Partnership' : 'Kemitraan'}</a></li>
          <li><a href="/#berita" class="hover:text-accent transition-colors">{locale === 'en' ? 'Media & News' : 'Media & Berita'}</a></li>
          <li><a href="/kontak" data-route="kontak" class="hover:text-accent transition-colors">{locale === 'en' ? 'Careers' : 'Karir'}</a></li>
          <li><a href="/kontak" data-route="kontak" class="hover:text-accent transition-colors">{locale === 'en' ? 'Contact' : 'Kontak'}</a></li>
          <li><a href="/kebijakan-privasi" class="hover:text-accent transition-colors">{locale === 'en' ? 'Privacy Policy' : 'Kebijakan Privasi'}</a></li>
        </ul>
      </div>

      <!-- Corporate Offices (Col 3) -->
      <div class="lg:col-span-3">
        <p class="font-heading text-accent text-xs font-semibold uppercase tracking-widest mb-4">
          {locale === 'en' ? 'Corporate Offices' : 'Kantor Representatif'}
        </p>
        <div class="space-y-4 text-xs text-white/80">
          <div>
            <p class="font-heading font-bold text-white text-xs mb-1">Bandung Office</p>
            <p class="text-white/70 leading-relaxed">
              Buahbatu Square Blk. A No.09, Cipagalo, Bojongsoang, Kab. Bandung 40267
            </p>
          </div>
          <div>
            <p class="font-heading font-bold text-white text-xs mb-1">Jakarta Office</p>
            <p class="text-white/70 leading-relaxed">
              Sequis Center Lt. 8 Kav 814, Jl. Jendral Sudirman No. 71, Senayan, Jakarta Selatan
            </p>
          </div>
          <div>
            <p class="font-heading font-bold text-white text-xs mb-1">Official Email</p>
            <a href={`mailto:${COMPANY.email}`} class="text-accent hover:underline">
              {COMPANY.email}
            </a>
          </div>
        </div>
      </div>

      <!-- Social & Connect (Col 2) -->
      <div class="lg:col-span-2">
        <p class="font-heading text-accent text-xs font-semibold uppercase tracking-widest mb-4">
          Connect
        </p>
        <ul class="space-y-2.5 text-xs text-white/80">
          <li>
            <a href="https://instagram.com/nimohighland" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors inline-flex items-center gap-1.5">
              <span>Instagram</span>
              <ArrowUpRight class="w-3 h-3 text-white/40" />
            </a>
          </li>
          <li>
            <a href="https://tiktok.com/@nimohighland" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors inline-flex items-center gap-1.5">
              <span>TikTok</span>
              <ArrowUpRight class="w-3 h-3 text-white/40" />
            </a>
          </li>
          <li>
            <a href="https://youtube.com/@nimolandgroup" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors inline-flex items-center gap-1.5">
              <span>YouTube</span>
              <ArrowUpRight class="w-3 h-3 text-white/40" />
            </a>
          </li>
          <li>
            <a href="https://linkedin.com/company/nimolandgroup" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors inline-flex items-center gap-1.5">
              <span>LinkedIn</span>
              <ArrowUpRight class="w-3 h-3 text-white/40" />
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="pt-6 flex flex-col sm:flex-row justify-between items-center gap-3 text-xs text-white/60 font-heading">
      <span>&copy; 2026 PT Nimo Hotel & Resort (Nimo Land Group). All rights reserved.</span>
      <span class="text-[11px] text-white/40">Building Indonesia’s Next Iconic Destinations</span>
    </div>

  </div>
</footer>
