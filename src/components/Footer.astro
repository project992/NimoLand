---
// SECTION 4: Footer corporate
const currentYear = new Date().getFullYear();
---
<footer class="bg-[#0E1E17] text-white/70 pt-20 pb-12 border-t border-accent/20 text-sm">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    
    <!-- Top Row: Brand & Main Navigation -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-8 pb-12 border-b border-white/10">
      <div>
        <h3 class="font-heading font-bold text-2xl text-white tracking-wide">
          NIMO LAND GROUP
        </h3>
        <p class="text-xs text-accent uppercase tracking-widest mt-1 font-medium">
          Integrated Tourism &amp; Hospitality
        </p>
      </div>

      <!-- Navigation Links -->
      <nav class="flex flex-wrap gap-x-6 sm:gap-x-8 gap-y-3 text-xs tracking-wider uppercase text-white/90 font-medium">
        <a href="/destinasi" data-route="destinations" class="hover:text-accent transition-colors">Destinations</a>
        <a href="/penginapan" data-route="hotels" class="hover:text-accent transition-colors">Hotels &amp; Resorts</a>
        <a href="/tentang-kami" class="hover:text-accent transition-colors">About Us</a>
        <a href="/kontak#partnership" data-route="kontak" class="hover:text-accent transition-colors">Partnership</a>
        <a href="/#recognition-media" data-route="beranda" class="hover:text-accent transition-colors">Media &amp; News</a>
        <a href="/karir" class="hover:text-accent transition-colors">Careers</a>
        <a href="/kontak" data-route="kontak" class="hover:text-accent transition-colors">Contact</a>
      </nav>
    </div>

    <!-- Middle Row: Offices & Social Links -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 py-12 border-b border-white/10">
      
      <!-- Bandung Office -->
      <div class="md:col-span-4 space-y-2">
        <p class="text-xs uppercase tracking-widest text-white font-semibold">Bandung Office</p>
        <p class="text-white/70 text-xs sm:text-sm font-light leading-relaxed">
          Buahbatu Square Blk. A No.09, Cipagalo, Bojongsoang, Kabupaten Bandung 40267
        </p>
      </div>

      <!-- Jakarta Office -->
      <div class="md:col-span-4 space-y-2">
        <p class="text-xs uppercase tracking-widest text-white font-semibold">Jakarta Office</p>
        <p class="text-white/70 text-xs sm:text-sm font-light leading-relaxed">
          Sequis Center Lt. 8 Kav 814, Jl. Jendral Sudirman No. 71, Senayan, Jakarta Selatan
        </p>
      </div>

      <!-- Social Media Outlines -->
      <div class="md:col-span-4 flex md:justify-end items-start space-x-6 pt-2 md:pt-0">
        <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="text-xs uppercase tracking-wider text-white/70 hover:text-accent border-b border-transparent hover:border-accent transition-all pb-0.5">
          Instagram
        </a>
        <a href="https://tiktok.com" target="_blank" rel="noopener noreferrer" class="text-xs uppercase tracking-wider text-white/70 hover:text-accent border-b border-transparent hover:border-accent transition-all pb-0.5">
          TikTok
        </a>
        <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class="text-xs uppercase tracking-wider text-white/70 hover:text-accent border-b border-transparent hover:border-accent transition-all pb-0.5">
          YouTube
        </a>
        <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="text-xs uppercase tracking-wider text-white/70 hover:text-accent border-b border-transparent hover:border-accent transition-all pb-0.5">
          LinkedIn
        </a>
      </div>
    </div>

    <!-- Bottom Row: Legal & Copyright -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-white/50 font-light">
      <p>&copy; {currentYear} Nimo Land Group. All rights reserved.</p>
      <div class="flex gap-6">
        <a href="/kebijakan-privasi" class="hover:text-accent transition-colors">Privacy Policy</a>
        <a href="/syarat-ketentuan" class="hover:text-accent transition-colors">Terms of Service</a>
      </div>
    </div>

  </div>
</footer>
