---
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Building2 from '@lucide/astro/icons/building-2';
import MapPin from '@lucide/astro/icons/map-pin';
import Mail from '@lucide/astro/icons/mail';
import { SITE } from '../lib/site.js';
import { COMPANY } from '../lib/data.js';

const t = key => Astro.locals.t(key);
---
<footer class="bg-bark pt-16 pb-8">
  <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10 pb-12 border-b border-white/10">
      <div>
        <a href="/" data-route="beranda" class="flex items-center gap-2 font-heading font-bold text-white text-xl mb-4">
          NIMO <span class="text-white/60 text-sm font-medium tracking-widest uppercase">Land Group</span>
        </a>
        <p class="text-white/55 text-sm leading-relaxed max-w-xs">
          {t('footer.desc')}
        </p>
      </div>
      <div>
        <p class="font-heading text-white text-sm font-semibold uppercase tracking-widest mb-5">{t('footer.jelajah')}</p>
        <ul class="space-y-3 text-sm text-white/55">
          <li><a href="/" data-route="beranda" class="hover:text-white transition-colors">{t('footer.beranda')}</a></li>
          <li><a href="/destinasi" data-route="destinations" class="hover:text-white transition-colors">{t('nav.destinations')}</a></li>
          <li><a href="/penginapan" data-route="hotels" class="hover:text-white transition-colors">{t('nav.hotels')} &amp; Resorts</a></li>
          <li><a href="/galeri" data-route="galeri" class="hover:text-white transition-colors">{t('nav.galeri')}</a></li>
        </ul>
      </div>
      <div>
        <p class="font-heading text-white text-sm font-semibold uppercase tracking-widest mb-5">{t('footer.informasi')}</p>
        <ul class="space-y-3 text-sm text-white/55">
          <li><a href="/kontak" data-route="kontak" class="hover:text-white transition-colors">{t('footer.kontak')}</a></li>
        </ul>
      </div>
      <div>
        <p class="font-heading text-white text-sm font-semibold uppercase tracking-widest mb-5">{t('footer.legal')}</p>
        <ul class="space-y-3 text-sm text-white/55">
          <li><a href="/tentang-kami" class="hover:text-white transition-colors">{t('footer.tentangKami')}</a></li>
          <li><a href="/kebijakan-privasi" class="hover:text-white transition-colors">{t('footer.kebijakanPrivasi')}</a></li>
          <li><a href="/pembatalan-refund" class="hover:text-white transition-colors">{t('footer.pembatalanRefund')}</a></li>
        </ul>
      </div>
    </div>

    <div class="py-6 border-b border-white/10 grid sm:grid-cols-3 gap-6 text-sm">
      <div>
        <p class="font-heading text-white/70 text-xs font-semibold uppercase tracking-widest mb-2 flex items-center gap-1.5">
          <Building2 class="w-4 h-4" /> {t('footer.namaBadanHukum')}
        </p>
        <p class="text-warn text-xs leading-relaxed">
          {COMPANY.legalName}
        </p>
      </div>
      <div>
        <p class="font-heading text-white/70 text-xs font-semibold uppercase tracking-widest mb-2 flex items-center gap-1.5">
          <MapPin class="w-4 h-4" /> {t('footer.alamatKantor')}
        </p>
        <p class="text-white/45 text-xs leading-relaxed">
          Bandung: Komplek Ruko Buahbatu Square Blk. A No.09, Cipagalo, Bojongsoang, Kabupaten Bandung 40267<br />
          Jakarta: Sequis Center Lt. 8 Kav 814, Jl. Jendral Sudirman No. 71, Senayan, Jakarta Selatan
        </p>
      </div>
      <div>
        <p class="font-heading text-white/70 text-xs font-semibold uppercase tracking-widest mb-2 flex items-center gap-1.5">
          <Mail class="w-4 h-4" /> {t('footer.emailResmi')}
        </p>
        <p class="text-white/45 text-xs leading-relaxed">
          <a href={`mailto:${COMPANY.email}`} class="hover:text-white transition-colors">{COMPANY.email}</a>
        </p>
      </div>
    </div>

    <div class="flex flex-col sm:flex-row justify-between items-center gap-3 pt-6 text-xs text-white/45 font-heading tracking-wide">
      <span>&copy; 2026 Nimo Land Group. All rights reserved.</span>
    </div>
  </div>
</footer>
