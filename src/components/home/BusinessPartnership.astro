---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Building2 from '@lucide/astro/icons/building-2';
import Mountain from '@lucide/astro/icons/mountain';
import MapPin from '@lucide/astro/icons/map-pin';
import TrendingUp from '@lucide/astro/icons/trending-up';
import Mail from '@lucide/astro/icons/mail';
import MessageSquare from '@lucide/astro/icons/message-square';
import { PARTNERSHIP_AREAS, COMPANY } from '../../lib/data.js';

const locale = Astro.locals.locale ?? 'id';
---
<section id="partnership" class="bg-surface py-20 lg:py-28 border-t border-line-soft">
  <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-14 lg:mb-18 reveal">
      <p class="eyebrow text-primary justify-center mb-3">
        <span class="w-6 h-px bg-primary"></span>
        {locale === 'en' ? 'Institutional Partnership' : 'Kemitraan & Kolaborasi Strategis'}
        <span class="w-6 h-px bg-primary"></span>
      </p>
      <h2 class="font-heading font-bold text-text-dark text-3xl sm:text-4xl lg:text-5xl leading-tight">
        {locale === 'en' ? 'Grow With Nimo' : 'Tumbuh Bersama Nimo Land Group'}
      </h2>
      <p class="text-muted text-sm sm:text-base leading-relaxed mt-4">
        {locale === 'en'
          ? 'We collaborate with land owners, hospitality developers, state-owned enterprises, and institutional investors to build landmark tourism assets across Indonesia.'
          : 'Kami membuka peluang kerja sama institusional dengan pemilik lahan strategis, pengembang properti, BUMN/BUMD, dan mitra investasi untuk membangun ekosistem pariwisata berkelanjutan.'}
      </p>
    </div>

    <!-- 4 Collaboration Pillars -->
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 mb-14">
      {PARTNERSHIP_AREAS.map((area, idx) => (
        <div class="card p-7 sm:p-8 rounded-3xl bg-background border border-line-soft reveal flex flex-col justify-between hover:border-accent/50 hover:shadow-lg transition-all duration-300">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-primary/10 text-primary flex items-center justify-center mb-6 font-heading font-black">
              0{idx + 1}
            </div>
            <h3 class="font-heading font-bold text-text-dark text-lg sm:text-xl mb-3 leading-snug">
              {area.title}
            </h3>
            <p class="text-muted text-xs sm:text-sm leading-relaxed">
              {area.desc}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Institutional CTA Banner -->
    <div class="rounded-3xl p-8 sm:p-10 lg:p-12 bg-gradient-to-br from-primary via-[#16382A] to-[#0F261C] text-white shadow-2xl border border-white/10 flex flex-col lg:flex-row lg:items-center justify-between gap-8 reveal">
      <div class="max-w-2xl">
        <span class="text-xs font-heading font-bold uppercase tracking-widest text-accent mb-2 block">Institutional Engagement</span>
        <h3 class="font-heading font-bold text-2xl sm:text-3xl text-white leading-tight mb-3">
          {locale === 'en' ? 'Ready to Explore Strategic Collaboration?' : 'Tertarik Menjajaki Kemitraan Strategis?'}
        </h3>
        <p class="text-white/80 text-xs sm:text-sm leading-relaxed">
          {locale === 'en'
            ? 'Connect directly with our corporate development and investment relations team to discuss asset development, joint ventures, or land utilization.'
            : 'Diskusikan rencana kolaborasi pengembangan destinasi, optimalisasi aset lahan, atau kemitraan resort bersama tim Corporate Development kami.'}
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-4 shrink-0">
        <a href="https://wa.me/628216402221?text=Halo%20Nimo%20Land%20Group,%20kami%20tertarik%20untuk%20mendiskusikan%20Institutional%20Partnership"
           target="_blank" rel="noopener noreferrer"
           class="btn-accent px-8 py-4 text-sm sm:text-base font-heading font-bold rounded-full shadow-lg hover:scale-105 transition-all inline-flex items-center gap-2">
          <MessageSquare class="w-4 h-4" />
          <span>{locale === 'en' ? 'Discuss a Partnership' : 'Diskusikan Kemitraan'}</span>
        </a>
        <a href={`mailto:${COMPANY.email}?subject=Inquiry%20Strategic%20Partnership%20-%20Nimo%20Land%20Group`}
           class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 text-white font-heading font-semibold px-6 py-4 rounded-full backdrop-blur-md border border-white/20 text-xs sm:text-sm transition-all">
          <Mail class="w-4 h-4" />
          <span>{COMPANY.email}</span>
        </a>
      </div>
    </div>

  </div>
</section>
