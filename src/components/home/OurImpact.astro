---
import Users from '@lucide/astro/icons/users';
import Store from '@lucide/astro/icons/store';
import Sparkles from '@lucide/astro/icons/sparkles';
import HeartHandshake from '@lucide/astro/icons/heart-handshake';
import { IMPACT_METRICS } from '../../lib/data.js';

const locale = Astro.locals.locale ?? 'id';
---
<section id="impact" class="bg-primary text-white py-20 lg:py-28 relative overflow-hidden">
  <div class="absolute inset-0 opacity-10 pointer-events-none bg-[radial-gradient(#C9A96A_1px,transparent_1px)] [background-size:24px_24px]"></div>
  
  <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-14 lg:mb-18 reveal">
      <p class="eyebrow text-accent justify-center mb-3">
        <span class="w-6 h-px bg-accent"></span>
        {locale === 'en' ? 'Social Impact & Sustainability' : 'Dampak Sosial & Keberlanjutan'}
        <span class="w-6 h-px bg-accent"></span>
      </p>
      <h2 class="font-heading font-bold text-white text-3xl sm:text-4xl lg:text-5xl leading-tight">
        {locale === 'en' ? IMPACT_METRICS.headline : 'Pariwisata yang Menciptakan Dampak Nyata'}
      </h2>
      <p class="text-white/80 text-sm sm:text-base leading-relaxed mt-4">
        {locale === 'en'
          ? 'We believe tourism is the greatest multiplier for community prosperity. Every Nimo destination is designed to empower local economies, nurture talent, and protect regional ecosystems.'
          : IMPACT_METRICS.subheadline}
      </p>
    </div>

    <!-- Impact Stats Cards -->
    <div class="grid md:grid-cols-3 gap-6 lg:gap-8 mb-16">
      {IMPACT_METRICS.stats.map((stat) => (
        <div class="p-8 rounded-3xl bg-white/5 border border-white/15 backdrop-blur-xs reveal hover:bg-white/10 hover:border-accent/40 transition-all duration-300">
          <div class="text-accent font-heading font-black text-4xl sm:text-5xl lg:text-6xl mb-3 tracking-tight">
            {stat.value}
          </div>
          <h3 class="font-heading font-bold text-white text-xl sm:text-2xl mb-2">
            {stat.label}
          </h3>
          <p class="text-white/70 text-xs sm:text-sm leading-relaxed">
            {stat.desc}
          </p>
        </div>
      ))}
    </div>

    <!-- Authentic Community Montage Gallery -->
    <div class="grid sm:grid-cols-3 gap-6 reveal">
      {IMPACT_METRICS.photos.map((item) => (
        <div class="group relative rounded-2xl overflow-hidden aspect-[4/3] img-shell border border-white/10 shadow-lg">
          <img src={item.img} alt={item.caption} loading="lazy"
               class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 opacity-90 group-hover:opacity-100" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent"></div>
          <div class="absolute bottom-4 left-4 right-4 text-xs font-medium text-white/90 leading-snug">
            {item.caption}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
