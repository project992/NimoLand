---
import Milestone from '@lucide/astro/icons/milestone';
import Sparkles from '@lucide/astro/icons/sparkles';
import { NIMO_JOURNEY } from '../../lib/data.js';

const locale = Astro.locals.locale ?? 'id';
---
<section id="journey" class="bg-surface py-20 lg:py-28 border-t border-line-soft">
  <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-14 lg:mb-18 reveal">
      <p class="eyebrow text-primary justify-center mb-3">
        <span class="w-6 h-px bg-primary"></span>
        {locale === 'en' ? 'Our Milestone Timeline' : 'Rekam Jejak & Milestone'}
        <span class="w-6 h-px bg-primary"></span>
      </p>
      <h2 class="font-heading font-bold text-text-dark text-3xl sm:text-4xl lg:text-5xl leading-tight">
        {locale === 'en' ? 'Nimo Journey' : 'Perjalanan Nimo Land Group'}
      </h2>
      <p class="text-muted text-sm sm:text-base leading-relaxed mt-4">
        {locale === 'en'
          ? 'From pioneering high-elevation iconic attractions to establishing an integrated national tourism and hospitality network.'
          : 'Dari pelopor atraksi ketinggian ikonik di Jawa Barat hingga membangun holding grup pariwisata terintegrasi skala nasional.'}
      </p>
    </div>

    <!-- Timeline Grid / Cards -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {NIMO_JOURNEY.map((item, idx) => (
        <div class="p-7 sm:p-8 rounded-3xl bg-background border border-line-soft reveal flex flex-col justify-between hover:border-accent/50 hover:shadow-md transition-all duration-300 relative group">
          <div>
            <div class="flex items-center justify-between gap-4 mb-4">
              <span class="text-2xl sm:text-3xl font-heading font-black text-primary group-hover:text-accent transition-colors">
                {item.year}
              </span>
              <span class="text-[10px] font-heading font-bold uppercase tracking-wider bg-primary/10 text-primary px-2.5 py-1 rounded-full">
                Step 0{idx + 1}
              </span>
            </div>
            <h3 class="font-heading font-bold text-text-dark text-lg sm:text-xl mb-3 leading-snug">
              {item.title}
            </h3>
            <p class="text-muted text-xs sm:text-sm leading-relaxed">
              {item.desc}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
