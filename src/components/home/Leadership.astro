---
import Award from '@lucide/astro/icons/award';
import Trophy from '@lucide/astro/icons/trophy';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import { LEADERSHIP } from '../../lib/data.js';

const locale = Astro.locals.locale ?? 'id';
---
<section id="leadership" class="bg-background py-20 lg:py-28 border-t border-line-soft">
  <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-14 lg:mb-18 reveal">
      <p class="eyebrow text-primary justify-center mb-3">
        <span class="w-6 h-px bg-primary"></span>
        {locale === 'en' ? 'Corporate Leadership' : 'Kepemimpinan Perusahaan'}
        <span class="w-6 h-px bg-primary"></span>
      </p>
      <h2 class="font-heading font-bold text-text-dark text-3xl sm:text-4xl lg:text-5xl leading-tight">
        {locale === 'en' ? 'Leadership' : 'Kepemimpinan'}
      </h2>
      <p class="text-muted text-sm sm:text-base leading-relaxed mt-4">
        {locale === 'en'
          ? 'Guided by visionary leadership and experienced hospitality executives committed to building Indonesia’s next iconic destinations.'
          : 'Dipimpin oleh figur visioner dan tim manajemen perhotelan berpengalaman yang berdedikasi membangun pariwisata berstandar global.'}
      </p>
    </div>

    <!-- Founder & CEO Feature Card -->
    <div class="mb-12 rounded-3xl bg-surface border border-line-soft p-8 sm:p-10 lg:p-12 shadow-sm reveal">
      <div class="grid lg:grid-cols-12 gap-8 items-center">
        <!-- Photo Side (4 cols) -->
        <div class="lg:col-span-4 relative aspect-[4/5] rounded-2xl overflow-hidden img-shell bg-primary/5 shadow-md">
          <img src={LEADERSHIP.founder.img} alt={LEADERSHIP.founder.name} class="w-full h-full object-cover" loading="lazy" />
          <div class="absolute bottom-3 left-3 right-3 bg-primary/95 backdrop-blur-md px-3.5 py-2 rounded-xl text-white text-[11px] font-heading font-semibold text-center border border-white/10">
            CNN Indonesia Awards 2024 Winner
          </div>
        </div>

        <!-- Bio Side (8 cols) -->
        <div class="lg:col-span-8 flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-2 text-xs font-semibold text-accent mb-2 uppercase tracking-widest font-heading">
              <Trophy class="w-4 h-4 text-accent" />
              <span>Founder & Chief Executive Officer</span>
            </div>
            <h3 class="font-heading font-bold text-text-dark text-2xl sm:text-3xl lg:text-4xl mb-3">
              {LEADERSHIP.founder.name}
            </h3>
            <div class="inline-block px-3 py-1 rounded bg-primary/5 border border-primary/15 text-primary text-xs font-semibold mb-6">
              {LEADERSHIP.founder.award}
            </div>
            <p class="text-muted text-sm sm:text-base leading-relaxed mb-6">
              {LEADERSHIP.founder.bio}
            </p>
            <p class="text-muted text-xs sm:text-sm leading-relaxed">
              "Kami mendedikasikan setiap pembangunan wahana, resort, dan taman rekreasi untuk mengangkat martabat pariwisata Indonesia ke panggung internasional sekaligus memberikan manfaat ekonomi langsung bagi masyarakat lokal."
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Executive Management Team Grid -->
    <div class="grid md:grid-cols-3 gap-6">
      {LEADERSHIP.executives.map((exec) => (
        <div class="p-6 sm:p-7 rounded-2xl bg-surface border border-line-soft reveal flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center mb-4">
              <ShieldCheck class="w-5 h-5 text-primary" />
            </div>
            <h4 class="font-heading font-bold text-text-dark text-lg mb-1">
              {exec.name}
            </h4>
            <p class="text-xs font-heading font-semibold text-accent mb-3">
              {exec.role}
            </p>
            <p class="text-muted text-xs sm:text-sm leading-relaxed">
              {exec.desc}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
