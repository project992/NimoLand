---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import MapPin from '@lucide/astro/icons/map-pin';
import CircleCheck from '@lucide/astro/icons/circle-check';
import { HOSPITALITY_COLLECTION } from '../../lib/data.js';

const locale = Astro.locals.locale ?? 'id';
---
<section id="resorts" class="bg-surface py-20 lg:py-28 border-t border-line-soft">
  <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
    
    <!-- Section Header -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-12 lg:mb-16 reveal">
      <div>
        <p class="eyebrow text-primary mb-3">
          <span class="w-6 h-px bg-primary"></span>
          {locale === 'en' ? 'Hotels & Resorts Collection' : 'Jaringan Hotel & Resort'}
        </p>
        <h2 class="font-heading font-bold text-text-dark text-3xl sm:text-4xl lg:text-5xl leading-tight max-w-xl">
          {locale === 'en' ? 'Stay With Nimo' : 'Stay With Nimo'}
        </h2>
      </div>
      <p class="text-muted text-sm sm:text-base max-w-md">
        {locale === 'en'
          ? 'Immersive hospitality experiences crafted in the heart of Indonesian nature, featuring Nordic cabins, hot spring onsens, and hillside retreats.'
          : 'Pengalaman menginap berkelas dunia di tengah keindahan alam Indonesia, memadukan kenyamanan modern dengan ketenangan alam pegunungan.'}
      </p>
    </div>

    <!-- Hospitality Cards (2x2 or 4 cols) -->
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {HOSPITALITY_COLLECTION.map((resort) => (
        <article class="card card-hover overflow-hidden flex flex-col justify-between group bg-background border border-line-soft rounded-3xl reveal transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-accent/40">
          <div>
            <!-- Resort Image -->
            <div class="relative aspect-[4/3] overflow-hidden img-shell">
              <img src={resort.img} data-fallback={resort.fb} alt={resort.name} loading="lazy"
                   class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
              <span class="absolute top-3.5 left-3.5 bg-primary/90 backdrop-blur-xs text-white text-[11px] font-heading font-semibold uppercase tracking-wider px-3 py-1 rounded-full shadow-sm">
                {resort.type}
              </span>
            </div>

            <!-- Content Area -->
            <div class="p-6">
              <div class="flex items-center gap-1.5 text-xs text-muted mb-2">
                <MapPin class="w-3.5 h-3.5 text-primary shrink-0" />
                <span class="line-clamp-1">{resort.location}</span>
              </div>

              <h3 class="font-heading font-bold text-text-dark text-lg sm:text-xl group-hover:text-primary transition-colors mb-2">
                <a href={`/penginapan/${resort.id}`} data-route="hotels">
                  {resort.name}
                </a>
              </h3>

              <!-- Starting Rate -->
              <div class="mt-3 mb-4 p-3 rounded-xl bg-surface border border-line-soft">
                <p class="text-[11px] text-muted uppercase tracking-wider font-heading">{locale === 'en' ? 'Starting from' : 'Mulai dari'}</p>
                <p class="font-heading font-black text-primary text-base sm:text-lg">{resort.startingRate} <span class="text-xs font-normal text-muted">/ malam</span></p>
              </div>

              <!-- Feature Highlights -->
              <ul class="space-y-1.5 text-xs text-muted">
                {resort.features.map((f) => (
                  <li class="flex items-center gap-1.5">
                    <CircleCheck class="w-3.5 h-3.5 text-accent shrink-0" />
                    <span class="line-clamp-1">{f}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Bottom Action Link -->
          <div class="p-6 pt-0 mt-auto border-t border-line-soft/40">
            <a href={`/penginapan/${resort.id}`} data-route="hotels"
               class="w-full btn-outline py-2.5 text-xs font-heading font-bold justify-center rounded-xl inline-flex items-center gap-1.5 group-hover:bg-primary group-hover:text-white group-hover:border-primary transition-all">
              <span>{locale === 'en' ? 'View Resort' : 'Lihat Resort'}</span>
              <ArrowRight class="w-3.5 h-3.5" />
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Bottom CTA: View All Accommodations -->
    <div class="mt-12 text-center reveal">
      <a href="/penginapan" data-route="hotels"
         class="inline-flex items-center gap-2 font-heading font-bold text-primary text-sm sm:text-base border-b-2 border-accent pb-1 hover:gap-3 transition-all">
        <span>{locale === 'en' ? 'View All Hotels & Resorts' : 'Lihat Seluruh Portofolio Penginapan & Resort'}</span>
        <ArrowRight class="w-4 h-4" />
      </a>
    </div>

  </div>
</section>
