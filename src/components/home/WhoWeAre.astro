---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Compass from '@lucide/astro/icons/compass';
import Target from '@lucide/astro/icons/target';
import Building2 from '@lucide/astro/icons/building-2';
import { ABOUT_PILLARS, CORPORATE_VISION, MOMENTS, localSrc } from '../../lib/data.js';

const locale = Astro.locals.locale ?? 'id';
---
<section id="about" class="bg-background py-20 lg:py-28 border-t border-line-soft">
  <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-12 lg:mb-16 reveal">
      <p class="eyebrow text-primary mb-3">
        <span class="w-6 h-px bg-primary"></span>
        {locale === 'en' ? 'About Nimo Land Group' : 'Tentang Nimo Land Group'}
      </p>
      <h2 class="font-heading font-bold text-text-dark text-3xl sm:text-4xl lg:text-5xl leading-tight">
        {locale === 'en' ? 'Building Indonesia’s Integrated Tourism Ecosystem' : 'Membangun Ekosistem Pariwisata Terintegrasi Indonesia'}
      </h2>
      <p class="text-muted text-sm sm:text-base leading-relaxed mt-4">
        {locale === 'en'
          ? 'Nimo Land Group (PT Nimo Hotel & Resort) is an integrated national tourism and hospitality holding developing iconic destinations, world-class lodging, and sustainable community empowerment.'
          : 'Nimo Land Group (PT Nimo Hotel & Resort) adalah kelompok usaha pariwisata nasional terintegrasi yang berdedikasi menciptakan destinasi mahakarya berkelanjutan dan bernilai ekonomi tinggi bagi daerah.'}
      </p>
    </div>

    <!-- Vision Banner Box -->
    <div class="mb-14 rounded-3xl p-8 sm:p-10 bg-gradient-to-r from-primary via-[#16382A] to-[#0F261C] text-white shadow-xl border border-white/10 relative overflow-hidden reveal">
      <div class="absolute right-0 top-0 bottom-0 w-1/3 opacity-10 bg-[radial-gradient(#C9A96A_1px,transparent_1px)] [background-size:16px_16px] pointer-events-none"></div>
      <div class="relative z-10 grid lg:grid-cols-12 gap-6 items-center">
        <div class="lg:col-span-3 flex items-center gap-3">
          <div class="w-12 h-12 rounded-2xl bg-accent/20 border border-accent/40 flex items-center justify-center text-accent shrink-0">
            <Target class="w-6 h-6" />
          </div>
          <div>
            <p class="text-[11px] font-heading font-bold uppercase tracking-widest text-accent">Group Vision</p>
            <p class="text-xs text-white/70">Visi Korporasi Jangka Panjang</p>
          </div>
        </div>
        <div class="lg:col-span-9 lg:border-l lg:border-white/15 lg:pl-8">
          <blockquote class="font-heading font-bold text-xl sm:text-2xl lg:text-3xl text-white leading-snug">
            "{locale === 'en' ? CORPORATE_VISION.statement : CORPORATE_VISION.statementId}"
          </blockquote>
        </div>
      </div>
    </div>

    <!-- 3 Pillars Grid -->
    <div class="grid md:grid-cols-3 gap-6 lg:gap-8 mb-16">
      {ABOUT_PILLARS.map((pillar, idx) => (
        <div class="card p-7 sm:p-8 rounded-3xl bg-surface border border-line-soft reveal flex flex-col justify-between transition-all duration-300 hover:border-accent/40 hover:-translate-y-1">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-primary/10 text-primary flex items-center justify-center font-heading font-black text-lg mb-6">
              0{idx + 1}
            </div>
            <p class="text-xs font-heading font-bold uppercase tracking-wider text-accent mb-2">
              {pillar.title}
            </p>
            <h3 class="font-heading font-bold text-text-dark text-xl sm:text-2xl mb-4 leading-snug">
              {pillar.subtitle}
            </h3>
            <p class="text-muted text-sm leading-relaxed">
              {pillar.content}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Interactive Moments Montage -->
    <div class="grid lg:grid-cols-12 gap-8 items-center bg-surface border border-line-soft rounded-3xl p-6 sm:p-10 reveal">
      <div class="lg:col-span-5">
        <span class="text-xs font-heading font-bold uppercase tracking-widest text-accent mb-2 block">Institutional Excellence</span>
        <h3 class="font-heading font-bold text-text-dark text-2xl sm:text-3xl leading-tight mb-4">
          {locale === 'en' ? 'Experience Iconic Standards' : 'Menghadirkan Standar Mahakarya di Setiap Destinasi'}
        </h3>
        <p class="text-muted text-sm sm:text-base leading-relaxed mb-6">
          {locale === 'en'
            ? 'Every project under Nimo Land Group is engineered with international safety benchmarks, environmental integration, and genuine local hospitality.'
            : 'Setiap kawasan destinasi dan resort dirancang dengan integrasi lansekap alami, standar keselamatan internasional, serta pelayanan khas Nusantara yang ramah dan profesional.'}
        </p>
        <a href="/tentang-kami" class="btn-primary px-6 py-3 text-sm font-heading font-semibold rounded-full inline-flex items-center gap-2">
          <span>{locale === 'en' ? 'Learn More About Us' : 'Pelajari Selengkapnya Tentang Kami'}</span>
          <ArrowRight class="w-4 h-4" />
        </a>
      </div>

      <div class="lg:col-span-7">
        <div id="momentSlider" class="relative aspect-[16/10] rounded-2xl overflow-hidden img-shell shadow-md">
          {MOMENTS.map((m, i) => (
            <div class={i === 0 ? 'moment-slide absolute inset-0 transition-opacity duration-500 opacity-100' : 'moment-slide absolute inset-0 transition-opacity duration-500 opacity-0'}>
              <img class="w-full h-full object-cover" alt=""
                   src={localSrc(m.img)} data-fallback={localSrc(m.fb)} loading={i === 0 ? 'eager' : 'lazy'} />
            </div>
          ))}
          <div class="absolute bottom-4 right-4 z-20 flex gap-2 bg-black/40 backdrop-blur-md px-3 py-1.5 rounded-full">
            {MOMENTS.map((_, i) => (
              <button type="button" aria-label={`Foto ${i + 1}`} data-mdot={i}
                      class={i === 0 ? 'w-2 h-2 rounded-full transition-all bg-white cursor-pointer' : 'w-2 h-2 rounded-full transition-all bg-white/40 cursor-pointer'}></button>
            ))}
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
