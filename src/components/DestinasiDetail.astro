---
import MapPin from '@lucide/astro/icons/map-pin';
import ArrowLeft from '@lucide/astro/icons/arrow-left';
import NimoImage from './NimoImage.astro';
import { SITE } from '../lib/site.js';
import { FOOTAGE } from '../lib/data.js';
import { BEST_PHOTOS } from '../lib/best-photos.js';

const { d } = Astro.props;
const brandSlug = (d.img || '').split('/')[2];
const bestPhotos = brandSlug ? BEST_PHOTOS[brandSlug] : undefined;
const video = FOOTAGE[d.id]?.aerial;
const isVideo = video && /\.(mp4|mov|webm)/i.test(video);

/* Server-rendered detail view for /destinasi/[slug]. The `.view` + data-view
   contract lets the client Router keep navigating the whole app from here. */
const flagship = d.id === 'nimo-highland';
---
<div class="view active" data-view="item-detail">
  <!-- Hero Section with Background Video / Media Behind Text -->
  <section class="relative bg-bark pt-32 pb-20 lg:pt-44 lg:pb-28 overflow-hidden min-h-[440px] flex items-center">
    
    <!-- Background Video / Media Overlay -->
    <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
      <!-- Instant high-res background image poster -->
      <img src={d.img} alt="" class="absolute inset-0 w-full h-full object-cover opacity-50 scale-105" />

      {isVideo && (
        <video class="absolute inset-0 w-full h-full object-cover opacity-65 scale-105"
               src={video} playsinline muted loop autoplay
               preload="metadata" aria-label={`Video Background ${d.name}`}></video>
      )}
      <!-- High contrast dark gradients ensuring text readability -->
      <div class="absolute inset-0 bg-gradient-to-t from-bark via-bark/80 to-bark/60"></div>
      <div class="absolute inset-0 bg-bark/35"></div>
    </div>

    <!-- Foreground Text Content -->
    <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 lg:px-10 w-full">
      <a href="/destinasi" data-route="destinations"
         class="inline-flex items-center gap-2 text-white/80 hover:text-white text-sm font-heading mb-8 transition-colors bg-bark/40 backdrop-blur-md px-3.5 py-1.5 rounded-full border border-white/10 w-fit">
        <ArrowLeft class="w-4 h-4" /> Semua destinasi
      </a>
      <div class="flex flex-wrap items-center gap-4">
        <p class="eyebrow text-amber-300/90 mb-0">
          <span class="w-6 h-px bg-amber-400/60"></span> {d.area}
        </p>
        {d.tag && <span class="bg-clay text-white text-[11px] font-heading font-bold uppercase tracking-wider px-3 py-1 rounded-full shadow-sm">{d.tag}</span>}
      </div>
      <h1 class="font-heading font-bold text-white text-4xl sm:text-5xl lg:text-6xl leading-tight max-w-3xl mt-4 drop-shadow-md">
        {d.name}
      </h1>
      <p class="text-white/90 text-sm sm:text-base mt-5 max-w-xl leading-relaxed drop-shadow-sm">
        {d.desc}
      </p>
    </div>
  </section>

  <section class="bg-canvas py-14 lg:py-20">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10 grid lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2 space-y-9">
        <div>
          <h2 class="font-heading font-semibold text-ink text-xl mb-3">Sorotan</h2>
          <div class="flex flex-wrap gap-2">
            {d.highlights.map(h => (
              <span class="text-xs bg-paper border border-line-soft text-muted px-3 py-1.5 rounded-full">{h}</span>
            ))}
          </div>
        </div>

        <div>
          <h2 class="font-heading font-semibold text-ink text-xl mb-4">Galeri (6 Footage)</h2>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
            {(bestPhotos ?? d.gallery).map((p, i) => (
              <div class="aspect-[4/3] rounded-xl overflow-hidden img-shell">
                {bestPhotos
                  ? <img src={p} alt={`${d.name} — foto ${i + 1}`} class="w-full h-full object-cover" loading="lazy" />
                  : <NimoImage remote={p} alt={`${d.name} — galeri ${i + 1}`} fill sizes="(min-width:1024px) 40vw, 100vw" />}
              </div>
            ))}
          </div>
        </div>
      </div>

      <aside class="space-y-5 lg:sticky lg:top-28 lg:self-start">
        <div class="relative aspect-[16/10] rounded-2xl overflow-hidden img-shell">
          <NimoImage remote={d.img} alt={d.name} fill eager sizes="(min-width:1024px) 30vw, 100vw" />
        </div>
        <div class="card p-6">
          <a href="/penginapan" data-route="hotels" class="btn-outline w-full py-3.5">Lihat Penginapan di Sini</a>
        </div>
        {flagship && (
            <p class="text-xs text-muted mt-4 leading-relaxed">
              <MapPin class="w-3.5 h-3.5 inline -mt-px" /> {SITE.addressHighland}
            </p>
          )}
        </div>
      </aside>
    </div>
  </section>
</div>