---
import ExternalLink from '@lucide/astro/icons/external-link';
import Newspaper from '@lucide/astro/icons/newspaper';
import Play from '@lucide/astro/icons/play';
import Trophy from '@lucide/astro/icons/trophy';
import { NEWS_SPOTLIGHT, NEWS_ARTICLES, MEDIA_VIDEOS } from '../lib/data.js';

const locale = Astro.locals.locale ?? 'id';
---
<section id="berita" class="bg-surface py-20 lg:py-28 border-t border-bark/5">
  <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
    
    <!-- Section Header -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-12 reveal">
      <div>
        <p class="eyebrow text-sage-deep mb-4">
          <span class="w-6 h-px bg-sage"></span> {locale === 'en' ? 'National News & Media' : 'Berita & Liputan Media Nasional'}
        </p>
        <h2 class="font-heading font-bold text-ink text-3xl sm:text-4xl lg:text-5xl leading-tight max-w-xl">
          {locale === 'en' ? 'Nimo Land Group in National Spotlight' : 'Nimo Land Group dalam Sorotan Nasional'}
        </h2>
      </div>
      <p class="text-muted text-sm sm:text-base max-w-md">
        {locale === 'en'
          ? 'Prestigious awards, official news coverage across top national portals, and featured documentary videos.'
          : 'Penghargaan bergengsi, liputan resmi portal berita nasional, dan dokumentasi video eksklusif jaringan Nimo Land.'}
      </p>
    </div>

    <!-- SPOTLIGHT: CNN INDONESIA AWARDS 2024 -->
    <div class="mb-14 reveal">
      <div class="relative rounded-3xl overflow-hidden bg-gradient-to-br from-bark via-bark/95 to-bark/90 text-white shadow-2xl border border-white/10">
        <div class="grid lg:grid-cols-12 items-stretch">
          
          <!-- Left Content -->
          <div class="lg:col-span-7 p-8 sm:p-10 lg:p-14 flex flex-col justify-between z-10">
            <div>
              <div class="flex flex-wrap items-center gap-3 mb-6">
                <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-amber-500/20 text-amber-300 border border-amber-500/30 shadow-sm">
                  <Trophy class="w-4 h-4 text-amber-400" />
                  {NEWS_SPOTLIGHT.badge}
                </span>
                <span class="text-xs text-white/60">
                  {NEWS_SPOTLIGHT.source} · {NEWS_SPOTLIGHT.date}
                </span>
              </div>

              <div class="inline-block px-3 py-1 rounded bg-white/10 text-xs font-medium text-white/90 mb-4">
                Kategori: <strong class="text-amber-300">{NEWS_SPOTLIGHT.award}</strong>
              </div>

              <h3 class="font-heading font-bold text-2xl sm:text-3xl lg:text-4xl text-white leading-snug mb-4">
                {NEWS_SPOTLIGHT.title}
              </h3>

              <p class="text-white/80 text-sm sm:text-base leading-relaxed mb-6">
                {NEWS_SPOTLIGHT.desc}
              </p>
            </div>

            <div class="flex flex-wrap items-center gap-4 pt-4 border-t border-white/10">
              <a href={NEWS_SPOTLIGHT.url} target="_blank" rel="noopener noreferrer"
                 class="btn-accent px-6 py-3 text-sm font-semibold inline-flex items-center gap-2">
                <span>{locale === 'en' ? 'Read Full Coverage on CNN Indonesia' : 'Baca Liputan di CNN Indonesia'}</span>
                <ExternalLink class="w-4 h-4" />
              </a>
              <span class="text-xs text-white/50 italic">
                {NEWS_SPOTLIGHT.location}
              </span>
            </div>
          </div>

          <!-- Right Image -->
          <div class="lg:col-span-5 relative min-h-[300px] lg:min-h-full img-shell">
            <img class="w-full h-full object-cover"
                 src={NEWS_SPOTLIGHT.img} data-fallback={NEWS_SPOTLIGHT.fb}
                 alt={NEWS_SPOTLIGHT.title} loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t lg:bg-gradient-to-r from-bark via-bark/30 to-transparent"></div>
            <div class="absolute bottom-4 right-4 bg-bark/85 backdrop-blur-md px-3 py-1.5 rounded-lg border border-white/15 text-[11px] text-white/90">
              Dokumentasi CNN Indonesia Awards 2024
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- PORTAL BERITA NASIONAL (ONLINE NEWS GRID) -->
    <div class="mb-16">
      <div class="flex items-center justify-between mb-6 reveal">
        <h3 class="font-heading font-bold text-ink text-xl sm:text-2xl flex items-center gap-2">
          <Newspaper class="w-5 h-5 text-sage-deep" />
          {locale === 'en' ? 'National News Portals' : 'Portal Berita Nasional'}
        </h3>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {NEWS_ARTICLES.map(art => (
          <a href={art.url} target="_blank" rel="noopener noreferrer"
             class="group card overflow-hidden flex flex-col justify-between hover:shadow-lg transition-all duration-300 reveal bg-white">
            <div>
              <div class="relative aspect-[16/10] overflow-hidden img-shell">
                <img class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                     src={art.img} data-fallback={art.fb} alt={art.title} loading="lazy" />
                <div class="absolute top-3 left-3 bg-bark/85 backdrop-blur-md px-2.5 py-1 rounded text-[11px] font-semibold text-white">
                  {art.source}
                </div>
                <div class="absolute bottom-3 right-3 bg-sage-deep/90 backdrop-blur-md px-2 py-0.5 rounded text-[10px] font-medium text-white">
                  {art.category}
                </div>
              </div>

              <div class="p-5">
                <p class="text-xs text-muted mb-2">{art.date}</p>
                <h4 class="font-heading font-bold text-ink text-base group-hover:text-sage-deep transition-colors leading-snug line-clamp-2 mb-2">
                  {art.title}
                </h4>
                <p class="text-muted text-xs leading-relaxed line-clamp-3">
                  {art.desc}
                </p>
              </div>
            </div>

            <div class="px-5 pb-5 pt-2 flex items-center justify-between text-xs font-semibold text-sage-deep border-t border-bark/5 mt-2">
              <span>{locale === 'en' ? 'Read Article' : 'Baca Berita'}</span>
              <ExternalLink class="w-3.5 h-3.5 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" />
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- DOKUMENTASI & LIPUTAN VIDEO YOUTUBE -->
    <div>
      <div class="flex items-center justify-between mb-6 reveal">
        <h3 class="font-heading font-bold text-ink text-xl sm:text-2xl flex items-center gap-2">
          <Play class="w-5 h-5 text-sage-deep fill-sage-deep/20" />
          {locale === 'en' ? 'Featured Video & YouTube Coverage' : 'Dokumentasi & Liputan Video'}
        </h3>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        {MEDIA_VIDEOS.map(vid => (
          <a href={vid.url} target="_blank" rel="noopener noreferrer"
             class="group relative rounded-2xl overflow-hidden bg-bark text-white aspect-[16/9] shadow-md reveal flex items-end">
            <img class="absolute inset-0 w-full h-full object-cover opacity-85 group-hover:opacity-75 transition-opacity group-hover:scale-105 duration-700"
                 src={vid.thumbnail} alt={vid.title} loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-bark via-bark/40 to-black/20"></div>

            <!-- Play Button Center Overlay -->
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-red-600/90 text-white flex items-center justify-center shadow-2xl group-hover:scale-110 group-hover:bg-red-600 transition-all duration-300">
                <Play class="w-6 h-6 sm:w-7 sm:h-7 fill-white translate-x-0.5" />
              </div>
            </div>

            <!-- Video Info Bottom Overlay -->
            <div class="relative z-10 p-5 sm:p-6 w-full">
              <span class="inline-block px-2.5 py-1 rounded bg-white/20 backdrop-blur-md text-[11px] font-semibold mb-2">
                {vid.badge} · {vid.channel}
              </span>
              <h4 class="font-heading font-bold text-white text-base sm:text-lg leading-snug group-hover:text-amber-300 transition-colors line-clamp-2">
                {vid.title}
              </h4>
            </div>
          </a>
        ))}
      </div>
    </div>

  </div>
</section>
