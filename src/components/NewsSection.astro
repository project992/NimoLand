---
import ExternalLink from '@lucide/astro/icons/external-link';
import Play from '@lucide/astro/icons/play';
import { MEDIA_VIDEOS } from '../lib/data.js';

const locale = Astro.locals.locale ?? 'id';
---
<section id="berita" class="bg-surface py-20 lg:py-28 border-t border-bark/5">
  <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
    
    <!-- Section Header -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-12 reveal">
      <div>
        <p class="eyebrow text-sage-deep mb-4">
          <span class="w-6 h-px bg-sage"></span> {locale === 'en' ? 'Official Video & Media' : 'Dokumentasi & Video Resmi'}
        </p>
        <h2 class="font-heading font-bold text-ink text-3xl sm:text-4xl lg:text-5xl leading-tight max-w-xl">
          {locale === 'en' ? 'Nimo Land Group in Action' : 'Nimo Land Group dalam Dokumentasi'}
        </h2>
      </div>
      <p class="text-muted text-sm sm:text-base max-w-md">
        {locale === 'en'
          ? 'Official company profile and community impact stories from Nimo Land Group.'
          : 'Tayangan profil perusahaan dan dokumentasi resmi komitmen sosial Nimo Land Group bersama masyarakat.'}
      </p>
    </div>

    <!-- DOKUMENTASI & VIDEO RESMI YOUTUBE -->
    <div class="grid md:grid-cols-2 gap-6 lg:gap-8">
      {MEDIA_VIDEOS.map(vid => (
        <a href={vid.url} target="_blank" rel="noopener noreferrer"
           class="group relative rounded-2xl overflow-hidden bg-bark text-white min-h-[320px] sm:min-h-[380px] shadow-xl reveal flex flex-col justify-end border border-white/10 hover:border-white/25 transition-all">
          <img class="absolute inset-0 w-full h-full object-cover opacity-80 group-hover:opacity-65 transition-opacity group-hover:scale-105 duration-700"
               src={vid.thumbnail} alt={vid.title} loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-bark via-bark/60 to-black/30"></div>

          <!-- YouTube Red Play Button Overlay -->
          <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
            <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-[#FF0000] text-white flex items-center justify-center shadow-2xl group-hover:scale-110 transition-all duration-300">
              <Play class="w-7 h-7 sm:w-8 sm:h-8 fill-white translate-x-0.5" />
            </div>
          </div>

          <!-- Video Info Bottom Overlay -->
          <div class="relative z-10 p-6 sm:p-8 w-full bg-gradient-to-t from-bark via-bark/90 to-transparent">
            <div class="flex flex-wrap items-center gap-2 mb-3">
              <span class="inline-block px-2.5 py-0.5 rounded bg-red-600 text-[11px] font-bold text-white shadow">
                YouTube
              </span>
              <span class="inline-block px-2.5 py-0.5 rounded bg-white/15 backdrop-blur-md text-[11px] font-semibold text-white/90">
                {vid.badge}
              </span>
              <span class="text-xs text-white/70">
                {vid.channel}
              </span>
            </div>
            <h3 class="font-heading font-bold text-white text-lg sm:text-2xl leading-snug group-hover:text-amber-300 transition-colors mb-2">
              {vid.title}
            </h3>
            <p class="text-white/80 text-xs sm:text-sm leading-relaxed line-clamp-2 mb-4">
              {vid.desc}
            </p>
            <div class="inline-flex items-center gap-2 text-xs font-semibold text-amber-300 group-hover:text-amber-200">
              <span>Tonton Video di YouTube</span>
              <ExternalLink class="w-3.5 h-3.5" />
            </div>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>
