---
import ExternalLink from '@lucide/astro/icons/external-link';
import Newspaper from '@lucide/astro/icons/newspaper';
import Play from '@lucide/astro/icons/play';
import Trophy from '@lucide/astro/icons/trophy';
import { NEWS_SPOTLIGHT, NEWS_ARTICLES, MEDIA_VIDEOS } from '../lib/data.js';

const locale = Astro.locals.locale ?? 'id';
---
<section id="berita" class="bg-surface py-20 lg:py-28 border-t border-bark/5">
  <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
    
    <!-- Section Header -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-12 reveal">
      <div>
        <p class="eyebrow text-sage-deep mb-4">
          <span class="w-6 h-px bg-sage"></span> {locale === 'en' ? 'National News & Media' : 'Berita & Liputan Media Nasional'}
        </p>
        <h2 class="font-heading font-bold text-ink text-3xl sm:text-4xl lg:text-5xl leading-tight max-w-xl">
          {locale === 'en' ? 'Nimo Land Group in National Spotlight' : 'Nimo Land Group dalam Sorotan Nasional'}
        </h2>
      </div>
      <p class="text-muted text-sm sm:text-base max-w-md">
        {locale === 'en'
          ? 'Prestigious awards, official news coverage across top national portals, and official documentary videos.'
          : 'Penghargaan bergengsi skala nasional, liputan resmi portal berita terpercaya, dan dokumentasi video eksklusif jaringan Nimo Land.'}
      </p>
    </div>

    <!-- SPOTLIGHT: CNN INDONESIA AWARDS 2024 -->
    <div class="mb-16 reveal">
      <div class="relative rounded-3xl overflow-hidden bg-gradient-to-br from-[#1b1e1b] via-bark to-[#151815] text-white shadow-2xl border border-white/10">
        <div class="grid lg:grid-cols-12 items-stretch">
          
          <!-- Left Content -->
          <div class="lg:col-span-7 p-8 sm:p-10 lg:p-12 flex flex-col justify-between z-10">
            <div>
              <div class="flex flex-wrap items-center gap-3 mb-5">
                <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-amber-500/20 text-amber-300 border border-amber-500/35 shadow-sm">
                  <Trophy class="w-4 h-4 text-amber-400" />
                  {NEWS_SPOTLIGHT.badge}
                </span>
                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded text-[11px] font-bold bg-[#CC0000] text-white">
                  {NEWS_SPOTLIGHT.source}
                </span>
                <span class="text-xs text-white/60">
                  {NEWS_SPOTLIGHT.date} · {NEWS_SPOTLIGHT.readTime}
                </span>
              </div>

              <div class="inline-block px-3 py-1 rounded bg-white/10 text-xs font-medium text-white/90 mb-4 border border-white/10">
                Kategori Resmi: <strong class="text-amber-300">{NEWS_SPOTLIGHT.award}</strong>
              </div>

              <h3 class="font-heading font-bold text-2xl sm:text-3xl lg:text-4xl text-white leading-snug mb-4">
                {NEWS_SPOTLIGHT.title}
              </h3>

              <p class="text-white/85 text-sm sm:text-base leading-relaxed mb-4">
                {NEWS_SPOTLIGHT.lead}
              </p>

              <div class="p-4 rounded-xl bg-white/5 border border-white/10 mb-6 italic text-white/80 text-xs sm:text-sm leading-relaxed">
                {NEWS_SPOTLIGHT.quote}
              </div>
            </div>

            <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-white/10">
              <a href={NEWS_SPOTLIGHT.url} target="_blank" rel="noopener noreferrer"
                 class="btn-accent px-6 py-3 text-sm font-semibold inline-flex items-center gap-2">
                <span>{locale === 'en' ? 'Read Full Coverage on CNN Indonesia' : 'Baca Liputan di CNN Indonesia'}</span>
                <ExternalLink class="w-4 h-4" />
              </a>
              <span class="text-xs text-white/50">
                Lokasi: {NEWS_SPOTLIGHT.location}
              </span>
            </div>
          </div>

          <!-- Right Image -->
          <div class="lg:col-span-5 relative min-h-[320px] lg:min-h-full img-shell">
            <img class="w-full h-full object-cover"
                 src={NEWS_SPOTLIGHT.img} data-fallback={NEWS_SPOTLIGHT.fb}
                 alt={NEWS_SPOTLIGHT.title} loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t lg:bg-gradient-to-r from-[#1b1e1b] via-bark/30 to-transparent"></div>
            <div class="absolute bottom-4 right-4 bg-bark/90 backdrop-blur-md px-3.5 py-2 rounded-xl border border-white/15 text-[11px] text-white/95 shadow-lg">
              <p class="font-semibold text-amber-300">CNN Indonesia Awards 2024</p>
              <p class="text-[10px] text-white/70">Jawa Barat Menyala untuk Indonesia Maju</p>
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- PORTAL BERITA NASIONAL (ONLINE NEWS GRID) -->
    <div class="mb-16">
      <div class="flex items-center justify-between mb-6 reveal">
        <h3 class="font-heading font-bold text-ink text-xl sm:text-2xl flex items-center gap-2">
          <Newspaper class="w-5 h-5 text-sage-deep" />
          {locale === 'en' ? 'National News Portals' : 'Liputan Portal Berita Nasional'}
        </h3>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {NEWS_ARTICLES.map(art => (
          <a href={art.url} target="_blank" rel="noopener noreferrer"
             class="group card overflow-hidden flex flex-col justify-between hover:shadow-xl hover:-translate-y-0.5 transition-all duration-300 reveal bg-white border border-bark/8">
            <div>
              <div class="relative aspect-[16/10] overflow-hidden img-shell">
                <img class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                     src={art.img} data-fallback={art.fb} alt={art.title} loading="lazy" />
                <div class="absolute top-3 left-3 px-2.5 py-1 rounded text-[11px] font-bold text-white shadow"
                     style={`background-color: ${art.sourceColor};`}>
                  {art.source}
                </div>
                <div class="absolute bottom-3 right-3 bg-bark/85 backdrop-blur-md px-2 py-0.5 rounded text-[10px] font-medium text-white">
                  {art.category}
                </div>
              </div>

              <div class="p-5">
                <div class="flex items-center justify-between text-xs text-muted mb-2.5">
                  <span>{art.date}</span>
                  <span class="text-[11px] text-sage-deep font-medium">{art.readTime}</span>
                </div>
                <h4 class="font-heading font-bold text-ink text-base group-hover:text-sage-deep transition-colors leading-snug line-clamp-2 mb-2.5">
                  {art.title}
                </h4>
                <p class="text-muted text-xs leading-relaxed line-clamp-3">
                  {art.desc}
                </p>
              </div>
            </div>

            <div class="px-5 pb-5 pt-2 flex items-center justify-between text-xs font-semibold text-sage-deep border-t border-bark/5 mt-2">
              <span>{locale === 'en' ? 'Read Full Article' : 'Baca Selengkapnya'}</span>
              <ExternalLink class="w-3.5 h-3.5 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" />
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- DOKUMENTASI & VIDEO RESMI YOUTUBE -->
    <div>
      <div class="flex items-center justify-between mb-6 reveal">
        <h3 class="font-heading font-bold text-ink text-xl sm:text-2xl flex items-center gap-2">
          <Play class="w-5 h-5 text-sage-deep fill-sage-deep/20" />
          {locale === 'en' ? 'Official Video & Documentation' : 'Dokumentasi & Video Resmi Nimo Land Group'}
        </h3>
      </div>

      <div class="grid md:grid-cols-2 gap-6 lg:gap-8">
        {MEDIA_VIDEOS.map(vid => (
          <a href={vid.url} target="_blank" rel="noopener noreferrer"
             class="group relative rounded-2xl overflow-hidden bg-bark text-white min-h-[320px] sm:min-h-[360px] shadow-xl reveal flex flex-col justify-end border border-white/10 hover:border-white/25 transition-all">
            <img class="absolute inset-0 w-full h-full object-cover opacity-80 group-hover:opacity-65 transition-opacity group-hover:scale-105 duration-700"
                 src={vid.thumbnail} alt={vid.title} loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-bark via-bark/60 to-black/30"></div>

            <!-- YouTube Red Play Button Overlay -->
            <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
              <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-[#FF0000] text-white flex items-center justify-center shadow-2xl group-hover:scale-110 transition-all duration-300">
                <Play class="w-7 h-7 sm:w-8 sm:h-8 fill-white translate-x-0.5" />
              </div>
            </div>

            <!-- Video Info Bottom Overlay -->
            <div class="relative z-10 p-6 sm:p-7 w-full bg-gradient-to-t from-bark via-bark/90 to-transparent">
              <div class="flex flex-wrap items-center gap-2 mb-2.5">
                <span class="inline-block px-2.5 py-0.5 rounded bg-red-600 text-[11px] font-bold text-white shadow">
                  YouTube
                </span>
                <span class="inline-block px-2.5 py-0.5 rounded bg-white/15 backdrop-blur-md text-[11px] font-semibold text-white/90">
                  {vid.badge}
                </span>
                <span class="text-xs text-white/70">
                  {vid.channel}
                </span>
              </div>
              <h4 class="font-heading font-bold text-white text-lg sm:text-xl leading-snug group-hover:text-amber-300 transition-colors mb-2">
                {vid.title}
              </h4>
              <p class="text-white/80 text-xs sm:text-sm leading-relaxed line-clamp-2 mb-3">
                {vid.desc}
              </p>
              <div class="inline-flex items-center gap-2 text-xs font-semibold text-amber-300 group-hover:text-amber-200">
                <span>Tonton Video di YouTube</span>
                <ExternalLink class="w-3.5 h-3.5" />
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>

  </div>
</section>
