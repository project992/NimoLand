---
// SECTION 5: Recognition & Media
---
<section id="recognition-media" class="bg-white text-stone-900 py-24 lg:py-32 border-b border-stone-200">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-16">
      <p class="text-xs uppercase tracking-[0.25em] text-stone-500 font-semibold mb-3">
        Validation & Endorsement
      </p>
      <h2 class="font-heading font-serif text-3xl sm:text-4xl text-stone-900 font-normal tracking-tight">
        Recognition & Media
      </h2>
    </div>

    <!-- Media / Institutional Logo Row (Grayscale to Color on Hover) -->
    <div class="flex flex-wrap items-center justify-center gap-8 sm:gap-14 lg:gap-20 py-8 border-y border-stone-200 mb-16">
      
      <!-- CNN Indonesia -->
      <div class="group flex items-center justify-center h-10 px-4 cursor-default">
        <span class="font-bold text-xl sm:text-2xl tracking-tighter text-stone-400 group-hover:text-[#CC0000] transition-colors duration-300">
          CNN <span class="font-light text-base text-stone-400 group-hover:text-stone-800 transition-colors duration-300">INDONESIA</span>
        </span>
      </div>

      <!-- MURI -->
      <div class="group flex items-center justify-center h-10 px-4 cursor-default">
        <span class="font-serif font-black text-xl sm:text-2xl tracking-widest text-stone-400 group-hover:text-[#B8860B] transition-colors duration-300">
          REKOR MURI
        </span>
      </div>

      <!-- Kompas -->
      <div class="group flex items-center justify-center h-10 px-4 cursor-default">
        <span class="font-serif font-bold text-xl sm:text-2xl text-stone-400 group-hover:text-[#005BAC] transition-colors duration-300">
          KOMPAS<span class="text-sm font-sans font-normal text-stone-400 group-hover:text-stone-700 transition-colors duration-300">.com</span>
        </span>
      </div>

      <!-- detikcom -->
      <div class="group flex items-center justify-center h-10 px-4 cursor-default">
        <span class="font-bold text-xl sm:text-2xl text-stone-400 group-hover:text-[#0D47A1] transition-colors duration-300">
          detik<span class="font-normal text-sm text-stone-400 group-hover:text-[#FF6F00] transition-colors duration-300">com</span>
        </span>
      </div>

    </div>

    <!-- Large Recognition Feature Photo -->
    <div class="max-w-4xl mx-auto">
      <div class="aspect-[16/9] overflow-hidden bg-stone-100 border border-stone-200">
        <!-- IMG: cnn-indonesia-awards-ceremony.jpg -->
        <img src="/brand/cnn-awards-2024.png" alt="Momen Penerimaan CNN Indonesia Awards 2024" class="w-full h-full object-cover grayscale-[15%] hover:grayscale-0 transition duration-700 ease-out" loading="lazy" />
      </div>
      <p class="mt-4 text-center text-xs sm:text-sm text-stone-500 font-light">
        Penerimaan CNN Indonesia Awards 2024 — Inisiatif Inovasi Layanan Pariwisata Berkelanjutan Nasional.
      </p>
    </div>

  </div>
</section>
