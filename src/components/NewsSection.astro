---
// SECTION 5: Recognition & Media
---
<section id="recognition-media" class="bg-surface text-text-dark py-20 lg:py-28 border-b border-line">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-14">
      <p class="text-xs uppercase tracking-[0.25em] text-accent font-semibold mb-3">
        Validation &amp; Endorsement
      </p>
      <h2 class="font-heading text-3xl sm:text-4xl text-text-dark font-bold tracking-tight">
        Recognition &amp; Media
      </h2>
    </div>

    <!-- Media / Institutional Logo Row (Grayscale to Color on Hover) -->
    <div class="flex flex-wrap items-center justify-center gap-8 sm:gap-14 lg:gap-20 py-8 border-y border-line mb-14">
      
      <!-- CNN Indonesia -->
      <div class="group flex items-center justify-center h-10 px-4 cursor-default transition-transform hover:scale-105">
        <span class="font-bold text-xl sm:text-2xl tracking-tighter text-muted/70 group-hover:text-[#CC0000] transition-colors duration-300">
          CNN <span class="font-light text-base text-muted/70 group-hover:text-text-dark transition-colors duration-300">INDONESIA</span>
        </span>
      </div>

      <!-- MURI -->
      <div class="group flex items-center justify-center h-10 px-4 cursor-default transition-transform hover:scale-105">
        <span class="font-heading font-black text-xl sm:text-2xl tracking-widest text-muted/70 group-hover:text-[#B8860B] transition-colors duration-300">
          REKOR MURI
        </span>
      </div>

      <!-- Kompas -->
      <div class="group flex items-center justify-center h-10 px-4 cursor-default transition-transform hover:scale-105">
        <span class="font-heading font-bold text-xl sm:text-2xl text-muted/70 group-hover:text-[#005BAC] transition-colors duration-300">
          KOMPAS<span class="text-sm font-sans font-normal text-muted/70 group-hover:text-text-dark transition-colors duration-300">.com</span>
        </span>
      </div>

      <!-- detikcom -->
      <div class="group flex items-center justify-center h-10 px-4 cursor-default transition-transform hover:scale-105">
        <span class="font-bold text-xl sm:text-2xl text-muted/70 group-hover:text-[#0D47A1] transition-colors duration-300">
          detik<span class="font-normal text-sm text-muted/70 group-hover:text-[#FF6F00] transition-colors duration-300">com</span>
        </span>
      </div>

    </div>

    <!-- Large Recognition Feature Photo -->
    <div class="max-w-4xl mx-auto">
      <div class="aspect-[16/9] overflow-hidden bg-paper border border-line rounded-2xl shadow-soft">
        <!-- IMG: cnn-indonesia-awards-ceremony.jpg -->
        <img src="/brand/cnn-awards-2024.png" alt="Momen Penerimaan CNN Indonesia Awards 2024" class="w-full h-full object-cover grayscale-[15%] hover:grayscale-0 transition duration-700 ease-out" loading="lazy" />
      </div>
      <p class="mt-4 text-center text-xs sm:text-sm text-muted font-medium">
        Penerimaan CNN Indonesia Awards 2024 — Inisiatif Inovasi Layanan Pariwisata Berkelanjutan Nasional.
      </p>
    </div>

  </div>
</section>
