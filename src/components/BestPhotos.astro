---
import { BEST_PHOTOS } from '../lib/best-photos.js';

/* Renders a "6 Foto Terbaik" grid for the brand folder derived from `src`
   (a /brand/<slug>/... image path). Shows nothing when the brand has <6
   photos, so callers don't need a separate fallback. */
const { src, name, heading = '6 Foto Terbaik', className = '' } = Astro.props;
const slug = (src || '').split('/')[2];
const photos = slug ? BEST_PHOTOS[slug] : undefined;
---

{photos && photos.length >= 6 && (
  <div class={className}>
    <h2 class="font-heading font-semibold text-ink text-xl mb-4">{heading}</h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
      {photos.map((p, i) => (
        <div class="aspect-[4/3] rounded-xl overflow-hidden img-shell">
          <img src={p} alt={`${name} — ${heading} ${i + 1}`}
               class="w-full h-full object-cover" loading="lazy" />
        </div>
      ))}
    </div>
  </div>
)}
