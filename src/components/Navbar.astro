---
import ChevronDown from '@lucide/astro/icons/chevron-down';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Menu from '@lucide/astro/icons/menu';
import X from '@lucide/astro/icons/x';
import User from '@lucide/astro/icons/user';
import LogIn from '@lucide/astro/icons/log-in';
import LogOut from '@lucide/astro/icons/log-out';
import Globe from '@lucide/astro/icons/globe';
import { DESTINATIONS, HOTELS } from '../lib/data.js';
import { LOCALES, LOCALE_LABELS, DEFAULT_LOCALE } from '../lib/i18n.js';

const user = Astro.locals.user;
const isCustomer = Astro.locals.isCustomer;
const locale = Astro.locals.locale ?? DEFAULT_LOCALE;
const t = key => Astro.locals.t(key);
const { active = '' } = Astro.props;
const navActive = route => (active === route ? ' active' : '');

const otherLocale = LOCALES.find(l => l !== locale);
---
<header id="navbar" class="fixed top-0 inset-x-0 z-50">
  <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
    <div class="flex items-center justify-between h-20">

      <a href="/" data-route="beranda" class="flex items-center gap-2 font-heading">
        <img src="/logo.png" alt="Nimo Land Group" class="h-9 w-auto transition-all" />
      </a>

      <nav class="hidden lg:flex items-center gap-7 font-heading text-sm font-medium">
        <a href="/" data-route="beranda" class={"nav-link transition-colors" + navActive('beranda')}>{t('nav.beranda')}</a>

        <div class="has-dropdown relative">
          <a href="/destinasi" data-route="destinations" class={"nav-link flex items-center gap-1 transition-colors" + navActive('destinations')}>
            {t('nav.destinations')}
            <ChevronDown class="w-3.5 h-3.5" />
          </a>
          <div class="dropdown-panel absolute left-1/2 -translate-x-1/2 top-full pt-4 w-72">
            <div class="bg-surface rounded-xl shadow-lg border border-line-soft py-2">
              <p class="px-5 py-2 text-[11px] font-heading uppercase tracking-widest text-muted">{t('nav.katalogDestinasi')}</p>
              <ul class="max-h-80 overflow-y-auto divide-y divide-line-soft">
                {DESTINATIONS.map(d => (
                  <li>
                    <a href={`/destinasi/${d.id}`}
                       class="block px-5 py-2.5 text-sm text-ink hover:bg-paper hover:text-sage-deep transition-colors">
                      {d.name}
                    </a>
                  </li>
                ))}
              </ul>
              <a href="/destinasi" data-route="destinations"
                 class="flex items-center gap-2 px-5 py-3 text-sm font-heading font-semibold text-sage-deep bg-paper hover:bg-sage-tint transition-colors">
                {t('nav.lihatSemuaDestinasi')}
                <ArrowRight class="w-4 h-4" />
              </a>
            </div>
          </div>
        </div>

        <div class="has-dropdown relative">
          <a href="/penginapan" data-route="hotels" class={"nav-link flex items-center gap-1 transition-colors" + navActive('hotels')}>
            {t('nav.hotels')}
            <ChevronDown class="w-3.5 h-3.5" />
          </a>
          <div class="dropdown-panel absolute left-1/2 -translate-x-1/2 top-full pt-4 w-72">
            <div class="bg-surface rounded-xl shadow-lg border border-line-soft py-2">
              <p class="px-5 py-2 text-[11px] font-heading uppercase tracking-widest text-muted">{t('nav.penginapan')}</p>
              <ul class="divide-y divide-line-soft">
                {HOTELS.map(h => (
                  <li>
                    <a href={`/penginapan/${h.id}`}
                       class="block px-5 py-2.5 text-sm text-ink hover:bg-paper hover:text-sage-deep transition-colors">
                      {h.name}<span class="block text-xs text-muted">{h.area}</span>
                    </a>
                  </li>
                ))}
              </ul>
              <a href="/penginapan" data-route="hotels"
                 class="flex items-center gap-2 px-5 py-3 text-sm font-heading font-semibold text-sage-deep bg-paper hover:bg-sage-tint transition-colors">
                {t('nav.lihatSemuaPenginapan')}
                <ArrowRight class="w-4 h-4" />
              </a>
            </div>
          </div>
        </div>

        <a href="/galeri" data-route="galeri" class={"nav-link transition-colors" + navActive('galeri')}>{t('nav.galeri')}</a>
        <a href="/kontak" data-route="kontak" class={"nav-link transition-colors" + navActive('kontak')}>{t('nav.kontak')}</a>
      </nav>

      <div class="flex items-center gap-2.5">
        {/* Language switcher */}
        <form method="POST" action="/api/locale" data-locale-form class="hidden lg:inline-flex">
          <input type="hidden" name="locale" value={otherLocale} />
          <input type="hidden" name="next" value={Astro.url.pathname} />
          <button type="submit" class="nav-account inline-flex items-center gap-1.5 border rounded-full px-3 py-2 font-heading font-semibold text-xs transition-colors" aria-label="Switch language">
            <Globe class="w-3.5 h-3.5" />
            {LOCALE_LABELS[otherLocale]}
          </button>
        </form>

        {/* ---- Account area: rendered server-side from the verified session ---- */}
        {isCustomer ? (
          <div class="has-dropdown relative hidden lg:block">
            <button type="button"
                    class="nav-account inline-flex items-center gap-2 border rounded-full pl-1.5 pr-3.5 py-1.5 transition-colors">
              <span class="w-7 h-7 rounded-full bg-sage text-white flex items-center justify-center font-heading font-bold text-xs">
                {user.name.trim().charAt(0).toUpperCase()}
              </span>
              <span class="font-heading font-semibold text-sm max-w-[9rem] truncate">{user.name}</span>
              <ChevronDown class="w-3.5 h-3.5 opacity-60" />
            </button>
            <div class="dropdown-panel absolute right-0 top-full pt-3 w-56">
              <div class="bg-surface rounded-xl shadow-lg border border-line-soft py-2">
                <p class="px-4 py-2 text-xs text-muted truncate">{user.email}</p>
                <button type="button" data-logout
                        class="w-full flex items-center gap-2.5 px-4 py-2.5 text-sm text-danger hover:bg-danger-tint transition-colors">
                  <LogOut class="w-4 h-4" /> {t('nav.keluar')}
                </button>
              </div>
            </div>
          </div>
        ) : (
          <a href="/login" class="nav-account hidden lg:inline-flex items-center gap-2 border rounded-full px-4 py-2.5 font-heading font-semibold text-sm transition-colors">
            <LogIn class="w-4 h-4" /> {t('nav.masuk')}
          </a>
        )}

        <button id="mobileMenuBtn" aria-label="Menu" aria-expanded="false"
                aria-controls="mobileMenu"
                class="burger lg:hidden p-2 rounded-md hover:bg-white/10 transition-colors">
          <Menu id="iconOpen" class="w-6 h-6" />
          <X id="iconClose" class="w-6 h-6 hidden" />
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile panel -->
  <div id="mobileMenu" class="lg:hidden hidden bg-surface border-t border-line-soft shadow-lg max-h-[80vh] overflow-y-auto">
    <nav class="px-5 py-4 flex flex-col gap-1 font-heading text-sm text-ink">
      <a href="/" data-route="beranda" class="py-3 border-b border-line-soft">{t('nav.beranda')}</a>

      <details class="border-b border-line-soft">
        <summary class="py-3 cursor-pointer list-none flex items-center justify-between">
          {t('nav.destinations')} <ChevronDown class="w-4 h-4" />
        </summary>
        <ul class="pb-2 pl-3 flex flex-col gap-1 text-muted">
          {DESTINATIONS.map(d => (
            <li><a href={`/destinasi/${d.id}`} class="block py-2">{d.name}</a></li>
          ))}
        </ul>
      </details>

      <details class="border-b border-line-soft">
        <summary class="py-3 cursor-pointer list-none flex items-center justify-between">
          {t('nav.hotels')} <ChevronDown class="w-4 h-4" />
        </summary>
        <ul class="pb-2 pl-3 flex flex-col gap-1 text-muted">
          {HOTELS.map(h => (
            <li><a href={`/penginapan/${h.id}`} class="block py-2">{h.name}</a></li>
          ))}
        </ul>
      </details>

      <a href="/galeri" data-route="galeri" class="py-3 border-b border-line-soft">{t('nav.galeri')}</a>
      <a href="/kontak" data-route="kontak" class="py-3 border-b border-line-soft">{t('nav.kontak')}</a>

      {/* Mobile language switcher */}
      <form method="POST" action="/api/locale" data-locale-form class="border-b border-line-soft">
        <input type="hidden" name="locale" value={otherLocale} />
        <input type="hidden" name="next" value={Astro.url.pathname} />
        <button type="submit" class="py-3 w-full text-left flex items-center gap-2 font-heading text-sm text-ink">
          <Globe class="w-4 h-4" /> {otherLocale === 'en' ? 'English' : 'Bahasa Indonesia'}
        </button>
      </form>

      {isCustomer ? (
        <>
          <button type="button" data-logout class="mt-2 btn-outline text-danger"><LogOut class="w-4 h-4" /> {t('nav.keluar')}</button>
        </>
      ) : (
        <a href="/login" class="mt-3 btn-outline"><LogIn class="w-4 h-4" /> {t('nav.masukAtauDaftar')}</a>
      )}

    </nav>
  </div>
</header>

<script is:inline>
  document.addEventListener('submit', async (e) => {
    const form = e.target.closest('[data-locale-form]');
    if (!form) return;
    e.preventDefault();
    const locale = form.querySelector('input[name="locale"]')?.value;
    const next = form.querySelector('input[name="next"]')?.value || '/';
    try {
      await fetch('/api/locale', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ locale, next }),
      });
    } catch {
      /* fall through to full reload regardless */
    }
    window.location.href = next;
  });
</script>

<style>
  .nav-account { color: #fff; border-color: rgba(255, 255, 255, .3); }
  .nav-account:hover { background: rgba(255, 255, 255, .12); }
  :global(#navbar.scrolled) .nav-account,
  :global(#navbar.solid) .nav-account {
    color: var(--color-ink);
    border-color: var(--color-line);
  }
  :global(#navbar.scrolled) .nav-account:hover,
  :global(#navbar.solid) .nav-account:hover { background: var(--color-paper); }
</style>
