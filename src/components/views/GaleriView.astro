---
const { class: cls = 'view' } = Astro.props;
---
<div class={cls} data-view="galeri">
  <section class="bg-primary pt-32 pb-16 lg:pt-40 lg:pb-20">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
      <p class="eyebrow text-accent mb-4">
        <span class="w-6 h-px bg-accent/60"></span> Galeri
      </p>
      <h1 class="font-heading font-bold text-white text-4xl sm:text-5xl lg:text-6xl leading-tight">
        Galeri Jaringan Destinasi Nimo Land
      </h1>
      <p class="text-white/80 text-sm sm:text-base mt-5 max-w-xl">
        Kumpulan momen dari seluruh destinasi Nimo Land Group &mdash; Nimo Tea Resort, Nimo Resort Ciater,
        Savia, Glamping Nimoza, Pinaru Park, Nimo Eye, Nimo Water Forest, Malang Skyland, Nimo Zoo,
        Nimo Kaldera Toba, Nimo Ecomarine, Aqua Game, hingga Punceling Park. Klik salah satu foto untuk membukanya
        dalam tampilan penuh. Gunakan tombol panah di layar, atau tombol
        <kbd class="px-1.5 py-0.5 rounded border border-white/25 text-[11px]">&larr;</kbd>
        dan <kbd class="px-1.5 py-0.5 rounded border border-white/25 text-[11px]">&rarr;</kbd>
        pada keyboard, untuk berpindah.
      </p>
    </div>
  </section>
  <section class="bg-background py-14 lg:py-20">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
      <div id="galleryGrid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4"></div>
    </div>
  </section>
</div>
