---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import MapPin from '@lucide/astro/icons/map-pin';
import Sunrise from '@lucide/astro/icons/sunrise';
import { DESTINATIONS, HERO_SLIDES, MOMENTS, localSrc } from '../../lib/data.js';

const { class: cls = 'view' } = Astro.props;
const locale = Astro.locals.locale ?? 'id';
const t = key => Astro.locals.t(key);
---
<div class={cls} data-view="beranda">

  <!-- ============ HERO ============ -->
  <section class="relative min-h-[100svh] flex items-end overflow-hidden bg-bark">
    <div id="heroTrack" class="absolute inset-0">
      {HERO_SLIDES.map((s, i) => (
        <div class:list={['hero-slide absolute inset-0', i === 0 && 'active']}>
          <div class="img-shell absolute inset-0">
            <img class="w-full h-full object-cover" alt=""
                 src={i === 0 ? localSrc(s.fb) : localSrc(s.img)} data-fallback={localSrc(s.fb)}
                 fetchpriority={i === 0 ? 'high' : undefined} loading={i === 0 ? 'eager' : 'lazy'} />
          </div>
        </div>
      ))}
    </div>

    {/* Flat scrim instead of the old three-stop gradient. */}
    <div class="absolute inset-0 bg-bark/55 pointer-events-none"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 lg:px-10 pb-16 lg:pb-24 w-full">
      <p class="eyebrow text-white/80 mb-4">
        <MapPin class="w-4 h-4" /> {t('hero.lokasi')}
      </p>
      <h1 class="font-heading font-bold text-white text-4xl sm:text-6xl lg:text-7xl leading-[1.05] max-w-3xl">
        Nimo Land Group
      </h1>

      <div class="flex flex-wrap items-center gap-4 mt-3">
        <p class="font-heading text-white/85 text-lg sm:text-2xl italic">{t('hero.tagline')}</p>
      </div>

      <p class="text-white/80 text-sm sm:text-base leading-relaxed max-w-xl mt-6">
        {t('hero.deskripsi')}
      </p>

      <div class="flex flex-wrap items-center gap-4 mt-8">
        <a href="/penginapan" data-route="hotels"
           class="btn-accent px-7 py-3.5 sm:text-base">
          {t('hero.lihatPenginapan')}
        </a>
      </div>
    </div>
  </section>

  <!-- ============ TENTANG ============ -->
  <section id="tentang" class="bg-surface py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <p class="eyebrow text-sage-deep mb-4">
            <span class="w-6 h-px bg-sage"></span> {t('tentang.eyebrow')}
          </p>
          <h2 class="font-heading font-bold text-ink text-3xl sm:text-4xl lg:text-5xl leading-tight max-w-lg">
            {t('tentang.judul')}
          </h2>

          <p class="text-muted text-sm sm:text-base leading-relaxed mt-6 max-w-lg">
            {t('tentang.paragraf1')}
          </p>
          <p class="text-muted text-sm sm:text-base leading-relaxed mt-4 max-w-lg">
            {t('tentang.paragraf2')}
          </p>

          <div class="grid grid-cols-3 gap-4 mt-10 max-w-md">
            <div class="border-l-2 border-sage pl-4">
              <p class="font-heading font-bold text-ink text-2xl">16</p>
              <p class="text-xs text-muted mt-1">{t('tentang.panorama')}</p>
            </div>
            <div class="border-l-2 border-sage pl-4">
              <p class="font-heading font-bold text-ink text-2xl">222</p>
              <p class="text-xs text-muted mt-1">{t('tentang.wahana')}</p>
            </div>
            <div class="border-l-2 border-sage pl-4">
              <p class="font-heading font-bold text-ink text-2xl">100.000++</p>
              <p class="text-xs text-muted mt-1">{t('tentang.buka')}</p>
            </div>
          </div>

          <a href="/destinasi" data-route="destinations"
             class="inline-flex items-center gap-2 font-heading font-semibold text-sage-deep text-sm mt-10 border-b-2 border-sage pb-1 hover:gap-3 transition-all">
            {t('tentang.selengkapnya')}
            <ArrowRight class="w-4 h-4" />
          </a>
        </div>

        <div class="relative reveal">
          <div id="momentSlider" class="relative aspect-[4/5] sm:aspect-[5/4] lg:aspect-[4/5] rounded-2xl overflow-hidden img-shell">
            {MOMENTS.map((m, i) => (
              <div class:list={['moment-slide absolute inset-0 transition-opacity duration-500', i === 0 ? 'opacity-100' : 'opacity-0']}>
                <img class="w-full h-full object-cover" alt=""
                     src={localSrc(m.img)} data-fallback={localSrc(m.fb)} loading={i === 0 ? 'eager' : 'lazy'} />
              </div>
            ))}
            <div class="absolute bottom-5 right-5 z-20 flex gap-2">
              {MOMENTS.map((_, i) => (
                <button type="button" aria-label={`Foto ${i + 1}`} data-mdot={i}
                        class:list={['w-2 h-2 rounded-full transition-all', i === 0 ? 'bg-white' : 'bg-white/40']}></button>
              ))}
            </div>
          </div>
          <div class="hidden sm:flex absolute -bottom-6 -left-6 card px-5 py-4 items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-sage-tint flex items-center justify-center shrink-0">
              <Sunrise class="w-5 h-5 text-sage-deep" />
            </div>
            <div>
              <p class="font-heading font-bold text-ink text-sm">{locale === 'en' ? 'Nationwide Network' : 'Jaringan Nasional'}</p>
              <p class="text-xs text-muted">{locale === 'en' ? 'Bandung · Subang · Malang · Toba · Bali' : 'Bandung · Subang · Malang · Toba · Bali'}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ JARINGAN DESTINASI ============ -->
  <section id="jaringan" class="bg-paper py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-10 reveal">
        <div>
          <p class="eyebrow text-sage-deep mb-4">
            <span class="w-6 h-px bg-sage"></span> {t('jaringan.eyebrow')}
          </p>
          <h2 class="font-heading font-bold text-ink text-3xl sm:text-4xl lg:text-5xl leading-tight max-w-lg">
            {t('jaringan.judul')}
          </h2>
        </div>
        <p class="text-muted text-sm max-w-sm">
          {t('jaringan.desc')}
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
        {DESTINATIONS.map(d => (
          <a href={`/destinasi/${d.id}`} data-route="destinations"
             class="group relative aspect-[4/3] rounded-xl overflow-hidden img-shell reveal">
            <img class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                 src={d.img} data-fallback={d.fb} alt={d.name} loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-bark/80 via-bark/20 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-4">
              <p class="font-heading font-semibold text-white text-sm leading-tight">{d.name}</p>
              <p class="text-white/60 text-xs mt-0.5 flex items-center gap-1">
                <MapPin class="w-3 h-3" /> {d.area}
              </p>
            </div>
          </a>
        ))}
      </div>

      <div class="flex justify-center mt-10">
        <a href="/destinasi" data-route="destinations"
           class="inline-flex items-center gap-2 font-heading font-semibold text-sage-deep text-sm border-b-2 border-sage pb-1 hover:gap-3 transition-all">
          {t('jaringan.lihatSemua')}
          <ArrowRight class="w-4 h-4" />
        </a>
      </div>
    </div>
  </section>

</div>
