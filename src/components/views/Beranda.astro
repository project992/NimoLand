---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import NewsSection from '../NewsSection.astro';
import { DESTINATIONS, localSrc } from '../../lib/data.js';

const { class: cls = 'view' } = Astro.props;
const locale = Astro.locals.locale ?? 'id';
const t = key => Astro.locals.t(key);

// 6 Flagship Destinations Showcase
const FLAGSHIP_DESTINATIONS = [
  {
    name: 'Nimo Highland',
    location: 'Pangalengan, Bandung',
    url: '/destinasi/nimo-highland',
    img: '/brand/nimo-highland/nh-01.jpg',
  },
  {
    name: 'Nimo Kaldera',
    location: 'Danau Toba, Sumatera Utara',
    url: '/destinasi/nimo-kaldera',
    img: '/brand/nimo-highland/nh-03.jpg',
  },
  {
    name: 'Nimo Water Forest',
    location: 'Purwakarta, Jawa Barat',
    url: '/destinasi/nimo-water-forest',
    img: '/brand/nimo-water-forest/nwf-01.jpg',
  },
  {
    name: 'Malang Skyland',
    location: 'Karangploso, Malang',
    url: '/destinasi/malang-skyland',
    img: '/brand/malang-skyland/malang-skyland-01.jpg',
  },
  {
    name: 'Nimo Eye',
    location: '1.400 MDPL Elevation',
    url: '/destinasi/nimo-eye',
    img: '/brand/nimo-highland/nh-02.jpg',
  },
  {
    name: 'Nimo Resort',
    location: 'Bandung & Ciater Clusters',
    url: '/penginapan',
    img: '/brand/nimo-tea-resort/nimo-tea-resort-02.jpg',
  },
];
---
<div class={cls} data-view="beranda">

  <!-- ============ HERO WITH CINEMATIC MONTAGE VIDEO ============ -->
  <section class="relative min-h-[100svh] flex items-end overflow-hidden bg-black">
    <!-- Cinematic Video Background & Fallback Poster -->
    <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
      <!-- High-res static fallback image -->
      <img class="w-full h-full object-cover opacity-90 scale-100" alt=""
           src="/aimg/tAG8ngQWBpj62NH-sryt3zUUZ3FH.jpg" fetchpriority="high" loading="eager" />

      <!-- Montage Drone Video (Nimo Highland, Tea Resort, Ciater, Pinaru, Savia, Bali) -->
      <video id="heroBgVideo" class="absolute inset-0 w-full h-full object-cover opacity-90 transition-opacity duration-700"
             src="/videos/nimo-tea-resort/aerial.mp4"
             data-playlist="/videos/nimo-tea-resort/aerial.mp4,/videos/nimo-resort-ciater/aerial.mp4,/videos/pinaru-park/aerial.MOV,/videos/savia-hotel-resort/aerial.mp4,/videos/new-dgyp-resort/aerial.mp4"
             playsinline muted loop autoplay preload="metadata"
             aria-label="Cinematic Drone Background Nimo Land Group"></video>

      <!-- Thin subtle dark gradient vignette keeping video clear while text pops -->
      <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/45 to-black/25"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-black/60 via-black/20 to-transparent"></div>
    </div>

    <!-- Hero Content -->
    <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 lg:px-10 pb-16 lg:pb-24 w-full">
      <h1 class="font-heading font-bold text-white text-4xl sm:text-6xl lg:text-7xl leading-[1.08] max-w-4xl drop-shadow-lg">
        {t('hero.headline')}
      </h1>

      <div class="mt-4 max-w-2xl">
        <p class="font-heading text-accent text-lg sm:text-2xl font-bold tracking-wide drop-shadow-md">
          {t('hero.tagline')}
        </p>
        <p class="text-white/90 text-sm sm:text-base leading-relaxed mt-3 drop-shadow-sm max-w-xl">
          {t('hero.deskripsi')}
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-4 mt-8">
        <a href="/destinasi" data-route="destinations"
           class="btn-accent px-8 py-4 sm:text-base font-heading font-bold rounded-full shadow-lg hover:scale-105 transition-transform">
          {t('hero.jelajahiDestinasi')}
        </a>
        <a href="/penginapan" data-route="hotels"
           class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 text-white font-heading font-semibold px-7 py-4 rounded-full backdrop-blur-md border border-white/20 transition-all text-sm sm:text-base">
          {t('hero.lihatPenginapan')}
        </a>
      </div>
    </div>
  </section>

  <!-- ========================================================================== -->
  <!-- 1. SECTION: Nimo in Numbers                                                -->
  <!-- ========================================================================== -->
  <section id="nimo-in-numbers" class="bg-stone-900 text-white py-20 lg:py-28 border-y border-stone-800">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      
      <!-- Section Header (Subtle & Restrained) -->
      <div class="mb-14 lg:mb-20">
        <p class="text-xs uppercase tracking-[0.25em] text-accent font-semibold mb-3">
          Scale &amp; Track Record
        </p>
        <h2 class="font-heading text-2xl sm:text-3xl lg:text-4xl text-stone-100 font-bold tracking-tight">
          Corporate Achievements at a Glance
        </h2>
      </div>

      <!-- 5-Column Metric Grid -->
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-y-12 gap-x-8 lg:gap-x-0" id="numbersGrid">
        
        <!-- Metric 1: 16 Destinations & Resorts -->
        <div class="lg:pr-8 lg:border-r border-stone-800 flex flex-col justify-between">
          <div>
            <span class="block font-heading text-4xl sm:text-5xl lg:text-6xl font-bold text-accent tracking-tight leading-none">
              <span class="count-up" data-target="16">16</span>
            </span>
            <p class="mt-4 text-sm font-semibold text-stone-200 uppercase tracking-wider">
              Destinations &amp; Resorts
            </p>
          </div>
          <p class="mt-2 text-xs text-stone-400">
            Across key tourism hubs
          </p>
        </div>

        <!-- Metric 2: 222 Rooms -->
        <div class="lg:px-8 lg:border-r border-stone-800 flex flex-col justify-between">
          <div>
            <span class="block font-heading text-4xl sm:text-5xl lg:text-6xl font-bold text-accent tracking-tight leading-none">
              <span class="count-up" data-target="222">222</span>
            </span>
            <p class="mt-4 text-sm font-semibold text-stone-200 uppercase tracking-wider">
              Rooms
            </p>
          </div>
          <p class="mt-2 text-xs text-stone-400">
            Villas, cabins &amp; glamping units
          </p>
        </div>

        <!-- Metric 3: 600+ Employees -->
        <div class="lg:px-8 lg:border-r border-stone-800 flex flex-col justify-between">
          <div>
            <span class="block font-heading text-4xl sm:text-5xl lg:text-6xl font-bold text-accent tracking-tight leading-none flex items-baseline">
              <span class="count-up" data-target="600">600</span>
              <span class="text-accent text-3xl sm:text-4xl font-bold ml-1">+</span>
            </span>
            <p class="mt-4 text-sm font-semibold text-stone-200 uppercase tracking-wider">
              Employees
            </p>
          </div>
          <p class="mt-2 text-xs text-stone-400">
            Trained local workforce
          </p>
        </div>

        <!-- Metric 4: 100K+ Visitors / Month -->
        <div class="lg:px-8 lg:border-r border-stone-800 flex flex-col justify-between">
          <div>
            <span class="block font-heading text-4xl sm:text-5xl lg:text-6xl font-bold text-accent tracking-tight leading-none flex items-baseline">
              <span class="count-up" data-target="100000" data-format="locale">100K</span>
              <span class="text-accent text-3xl sm:text-4xl font-bold ml-1">+</span>
            </span>
            <p class="mt-4 text-sm font-semibold text-stone-200 uppercase tracking-wider">
              Visitors / Month
            </p>
          </div>
          <p class="mt-2 text-xs text-stone-400">
            Monthly visitor footfall
          </p>
        </div>

        <!-- Metric 5: 5,000+ MSMEs Empowered -->
        <div class="col-span-2 md:col-span-1 lg:pl-8 flex flex-col justify-between">
          <div>
            <span class="block font-heading text-4xl sm:text-5xl lg:text-6xl font-bold text-accent tracking-tight leading-none flex items-baseline">
              <span class="count-up" data-target="5000" data-format="locale">5,000</span>
              <span class="text-accent text-3xl sm:text-4xl font-bold ml-1">+</span>
            </span>
            <p class="mt-4 text-sm font-semibold text-stone-200 uppercase tracking-wider">
              MSMEs Empowered
            </p>
          </div>
          <p class="mt-2 text-xs text-stone-400">
            Community ecosystem partners
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- ========================================================================== -->
  <!-- 3. SECTION: Flagship Destinations (6 Destinasi Pilihan)                    -->
  <!-- ========================================================================== -->
  <section id="flagship-destinations" class="bg-stone-950 text-white py-24 lg:py-32">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
        <div>
          <p class="text-xs uppercase tracking-[0.25em] text-accent font-semibold mb-3">
            Portfolio
          </p>
          <h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight">
            Flagship Destinations
          </h2>
        </div>
        <p class="text-stone-400 text-sm sm:text-base max-w-md font-light">
          A curated showcase of our most recognizable theme parks, panoramic attractions, and resort complexes across Indonesia.
        </p>
      </div>

      <!-- 6 Flagship Destinations Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {FLAGSHIP_DESTINATIONS.map((dest) => (
          <a href={dest.url} data-route={dest.url.startsWith('/destinasi') ? 'destinations' : 'hotels'}
             class="group relative block aspect-[4/5] overflow-hidden bg-stone-800 rounded-2xl">
            <img src={dest.img} alt={dest.name} loading="lazy"
                 class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-transparent"></div>
            <div class="absolute inset-x-0 bottom-0 p-8">
              <p class="text-xs uppercase tracking-widest text-accent font-semibold mb-1">{dest.location}</p>
              <h3 class="font-heading text-2xl text-white font-bold group-hover:text-accent transition-colors">{dest.name}</h3>
            </div>
          </a>
        ))}
      </div>

      <!-- Bottom Action Button -->
      <div class="mt-16 lg:mt-20 text-center">
        <a href="/destinasi" data-route="destinations"
           class="inline-flex items-center gap-3 border border-stone-600 hover:border-accent text-stone-200 hover:text-white px-9 py-4 text-sm font-semibold tracking-wider uppercase rounded-full transition-all duration-300 hover:scale-105">
          <span>Explore All Destinations</span>
          <ArrowRight class="w-4 h-4 text-accent" />
        </a>
      </div>

    </div>
  </section>

  <!-- ========================================================================== -->
  <!-- 5. SECTION: Recognition & Media                                            -->
  <!-- ========================================================================== -->
  <NewsSection />

</div>
