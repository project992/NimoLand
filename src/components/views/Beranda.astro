---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import MapPin from '@lucide/astro/icons/map-pin';
import Sunrise from '@lucide/astro/icons/sunrise';
import { DESTINATIONS, HERO_SLIDES, MOMENTS, localSrc } from '../../lib/data.js';

const { class: cls = 'view' } = Astro.props;
const locale = Astro.locals.locale ?? 'id';
const t = key => Astro.locals.t(key);
---
<div class={cls} data-view="beranda">

  <!-- ============ HERO WITH CINEMATIC MONTAGE VIDEO ============ -->
  <section class="relative min-h-[100svh] flex items-end overflow-hidden bg-black">
    <!-- Cinematic Video Background & Fallback Poster -->
    <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
      <!-- High-res static fallback image -->
      <img class="w-full h-full object-cover opacity-90 scale-100" alt=""
           src="/aimg/tAG8ngQWBpj62NH-sryt3zUUZ3FH.jpg" fetchpriority="high" loading="eager" />

      <!-- Montage Drone Video (Nimo Highland, Tea Resort, Ciater, Pinaru, Savia, Bali) -->
      <video id="heroBgVideo" class="absolute inset-0 w-full h-full object-cover opacity-90 transition-opacity duration-700"
             src="/videos/nimo-tea-resort/aerial.mp4"
             data-playlist="/videos/nimo-tea-resort/aerial.mp4,/videos/nimo-resort-ciater/aerial.mp4,/videos/pinaru-park/aerial.MOV,/videos/savia-hotel-resort/aerial.mp4,/videos/new-dgyp-resort/aerial.mp4"
             playsinline muted loop autoplay preload="metadata"
             aria-label="Cinematic Drone Background Nimo Land Group"></video>

      <!-- Thin subtle dark gradient vignette keeping video clear while text pops -->
      <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/45 to-black/25"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-black/60 via-black/20 to-transparent"></div>
    </div>

    <!-- Hero Content -->
    <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 lg:px-10 pb-16 lg:pb-24 w-full">
      <div class="inline-flex items-center gap-2 text-accent bg-black/40 backdrop-blur-md px-4 py-1.5 rounded-full border border-white/15 mb-5 text-xs sm:text-sm font-heading font-semibold shadow-md">
        <MapPin class="w-3.5 h-3.5 text-accent" /> {t('hero.lokasi')}
      </div>

      <h1 class="font-heading font-bold text-white text-4xl sm:text-6xl lg:text-7xl leading-[1.08] max-w-4xl drop-shadow-lg">
        {t('hero.headline')}
      </h1>

      <div class="mt-4 max-w-2xl">
        <p class="font-heading text-accent text-lg sm:text-2xl font-bold tracking-wide drop-shadow-md">
          {t('hero.tagline')}
        </p>
        <p class="text-white/90 text-sm sm:text-base leading-relaxed mt-3 drop-shadow-sm max-w-xl">
          {t('hero.deskripsi')}
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-4 mt-8">
        <a href="/destinasi" data-route="destinations"
           class="btn-accent px-8 py-4 sm:text-base font-heading font-bold rounded-full shadow-lg hover:scale-105 transition-transform">
          {t('hero.jelajahiDestinasi')}
        </a>
        <a href="/penginapan" data-route="hotels"
           class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 text-white font-heading font-semibold px-7 py-4 rounded-full backdrop-blur-md border border-white/20 transition-all text-sm sm:text-base">
          {t('hero.lihatPenginapan')}
        </a>
      </div>
    </div>
  </section>

  <!-- ============ SECTION: NIMO IN NUMBERS ============ -->
  <section id="nimo-in-numbers" class="bg-primary text-white py-16 lg:py-24 relative overflow-hidden border-y border-white/10">
    <div class="absolute inset-0 opacity-10 pointer-events-none bg-[radial-gradient(#C9A96A_1px,transparent_1px)] [background-size:24px_24px]"></div>
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10 relative z-10">
      
      <div class="text-center max-w-3xl mx-auto mb-12 lg:mb-16">
        <p class="eyebrow text-accent justify-center mb-3">
          <span class="w-6 h-px bg-accent"></span> {t('numbers.eyebrow')} <span class="w-6 h-px bg-accent"></span>
        </p>
        <h2 class="font-heading font-bold text-white text-3xl sm:text-4xl lg:text-5xl leading-tight">
          {t('numbers.judul')}
        </h2>
        <p class="text-white/80 text-sm sm:text-base leading-relaxed mt-4">
          {t('numbers.desc')}
        </p>
      </div>

      <!-- Stats Grid / Cards with Bold Figures & Count-Up Animation -->
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 sm:gap-6" id="numbersGrid">
        
        <!-- Card 1: 16 Theme Park & Resort -->
        <div class="stat-card bg-white/5 hover:bg-white/10 border border-white/15 backdrop-blur-xs rounded-2xl p-6 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1 hover:border-accent/50 group">
          <div>
            <div class="text-accent text-3xl sm:text-4xl lg:text-5xl font-heading font-black tracking-tight flex items-baseline">
              <span class="count-up" data-target="16">16</span>
            </div>
            <p class="font-heading font-bold text-white text-base sm:text-lg mt-3 leading-snug group-hover:text-accent transition-colors">
              {t('numbers.stat1')}
            </p>
          </div>
          <p class="text-[11px] sm:text-xs text-white/60 mt-2 font-medium">
            {t('numbers.stat1Sub')}
          </p>
        </div>

        <!-- Card 2: 222 Rooms -->
        <div class="stat-card bg-white/5 hover:bg-white/10 border border-white/15 backdrop-blur-xs rounded-2xl p-6 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1 hover:border-accent/50 group">
          <div>
            <div class="text-accent text-3xl sm:text-4xl lg:text-5xl font-heading font-black tracking-tight flex items-baseline">
              <span class="count-up" data-target="222">222</span>
            </div>
            <p class="font-heading font-bold text-white text-base sm:text-lg mt-3 leading-snug group-hover:text-accent transition-colors">
              {t('numbers.stat2')}
            </p>
          </div>
          <p class="text-[11px] sm:text-xs text-white/60 mt-2 font-medium">
            {t('numbers.stat2Sub')}
          </p>
        </div>

        <!-- Card 3: 100.000+ Visitors/bulan -->
        <div class="stat-card bg-white/5 hover:bg-white/10 border border-white/15 backdrop-blur-xs rounded-2xl p-6 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1 hover:border-accent/50 group">
          <div>
            <div class="text-accent text-3xl sm:text-4xl lg:text-5xl font-heading font-black tracking-tight flex items-baseline">
              <span class="count-up" data-target="100000" data-format="locale">100.000</span>
              <span class="text-accent text-2xl sm:text-3xl font-bold ml-0.5">+</span>
            </div>
            <p class="font-heading font-bold text-white text-base sm:text-lg mt-3 leading-snug group-hover:text-accent transition-colors">
              {t('numbers.stat3')}
            </p>
          </div>
          <p class="text-[11px] sm:text-xs text-white/60 mt-2 font-medium">
            {t('numbers.stat3Sub')}
          </p>
        </div>

        <!-- Card 4: 600+ Employees -->
        <div class="stat-card bg-white/5 hover:bg-white/10 border border-white/15 backdrop-blur-xs rounded-2xl p-6 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1 hover:border-accent/50 group">
          <div>
            <div class="text-accent text-3xl sm:text-4xl lg:text-5xl font-heading font-black tracking-tight flex items-baseline">
              <span class="count-up" data-target="600">600</span>
              <span class="text-accent text-2xl sm:text-3xl font-bold ml-0.5">+</span>
            </div>
            <p class="font-heading font-bold text-white text-base sm:text-lg mt-3 leading-snug group-hover:text-accent transition-colors">
              {t('numbers.stat4')}
            </p>
          </div>
          <p class="text-[11px] sm:text-xs text-white/60 mt-2 font-medium">
            {t('numbers.stat4Sub')}
          </p>
        </div>

        <!-- Card 5: 5.000+ UMKM Diberdayakan -->
        <div class="stat-card col-span-2 md:col-span-1 bg-white/5 hover:bg-white/10 border border-white/15 backdrop-blur-xs rounded-2xl p-6 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1 hover:border-accent/50 group">
          <div>
            <div class="text-accent text-3xl sm:text-4xl lg:text-5xl font-heading font-black tracking-tight flex items-baseline">
              <span class="count-up" data-target="5000" data-format="locale">5.000</span>
              <span class="text-accent text-2xl sm:text-3xl font-bold ml-0.5">+</span>
            </div>
            <p class="font-heading font-bold text-white text-base sm:text-lg mt-3 leading-snug group-hover:text-accent transition-colors">
              {t('numbers.stat5')}
            </p>
          </div>
          <p class="text-[11px] sm:text-xs text-white/60 mt-2 font-medium">
            {t('numbers.stat5Sub')}
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- ============ TENTANG ============ -->
  <section id="tentang" class="bg-background py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <p class="eyebrow text-primary mb-4">
            <span class="w-6 h-px bg-primary"></span> {t('tentang.eyebrow')}
          </p>
          <h2 class="font-heading font-bold text-text-dark text-3xl sm:text-4xl lg:text-5xl leading-tight max-w-lg">
            {t('tentang.judul')}
          </h2>

          <p class="text-muted text-sm sm:text-base leading-relaxed mt-6 max-w-lg">
            {t('tentang.paragraf1')}
          </p>
          <p class="text-muted text-sm sm:text-base leading-relaxed mt-4 max-w-lg">
            {t('tentang.paragraf2')}
          </p>

          <div class="grid grid-cols-3 gap-4 mt-10 max-w-md">
            <div class="border-l-2 border-accent pl-4">
              <p class="font-heading font-bold text-text-dark text-2xl">16</p>
              <p class="text-xs text-muted mt-1">{t('tentang.panorama')}</p>
            </div>
            <div class="border-l-2 border-accent pl-4">
              <p class="font-heading font-bold text-text-dark text-2xl">222</p>
              <p class="text-xs text-muted mt-1">{t('tentang.wahana')}</p>
            </div>
            <div class="border-l-2 border-accent pl-4">
              <p class="font-heading font-bold text-text-dark text-2xl">100.000++</p>
              <p class="text-xs text-muted mt-1">{t('tentang.buka')}</p>
            </div>
          </div>

          <a href="/destinasi" data-route="destinations"
             class="inline-flex items-center gap-2 font-heading font-semibold text-primary text-sm mt-10 border-b-2 border-accent pb-1 hover:gap-3 transition-all">
            {t('tentang.selengkapnya')}
            <ArrowRight class="w-4 h-4" />
          </a>
        </div>

        <div class="relative reveal">
          <div id="momentSlider" class="relative aspect-[4/5] sm:aspect-[5/4] lg:aspect-[4/5] rounded-2xl overflow-hidden img-shell">
            {MOMENTS.map((m, i) => (
              <div class:list={['moment-slide absolute inset-0 transition-opacity duration-500', i === 0 ? 'opacity-100' : 'opacity-0']}>
                <img class="w-full h-full object-cover" alt=""
                     src={localSrc(m.img)} data-fallback={localSrc(m.fb)} loading={i === 0 ? 'eager' : 'lazy'} />
              </div>
            ))}
            <div class="absolute bottom-5 right-5 z-20 flex gap-2">
              {MOMENTS.map((_, i) => (
                <button type="button" aria-label={`Foto ${i + 1}`} data-mdot={i}
                        class:list={['w-2 h-2 rounded-full transition-all', i === 0 ? 'bg-white' : 'bg-white/40']}></button>
              ))}
            </div>
          </div>
          <div class="hidden sm:flex absolute -bottom-6 -left-6 card px-5 py-4 items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center shrink-0">
              <Sunrise class="w-5 h-5 text-primary" />
            </div>
            <div>
              <p class="font-heading font-bold text-text-dark text-sm">{locale === 'en' ? 'Nationwide Network' : 'Jaringan Nasional'}</p>
              <p class="text-xs text-muted">{locale === 'en' ? 'Bandung · Subang · Malang · Toba · Bali' : 'Bandung · Subang · Malang · Toba · Bali'}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ JARINGAN DESTINASI ============ -->
  <section id="jaringan" class="bg-surface py-20 lg:py-28 border-t border-line-soft">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-10 reveal">
        <div>
          <p class="eyebrow text-primary mb-4">
            <span class="w-6 h-px bg-primary"></span> {t('jaringan.eyebrow')}
          </p>
          <h2 class="font-heading font-bold text-text-dark text-3xl sm:text-4xl lg:text-5xl leading-tight max-w-lg">
            {t('jaringan.judul')}
          </h2>
        </div>
        <p class="text-muted text-sm max-w-sm">
          {t('jaringan.desc')}
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
        {DESTINATIONS.map(d => (
          <a href={`/destinasi/${d.id}`} data-route="destinations"
             class="group relative aspect-[4/3] rounded-xl overflow-hidden img-shell reveal border border-line-soft hover:border-accent/50 transition-all">
            <img class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                 src={d.img} data-fallback={d.fb} alt={d.name} loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-primary/85 via-primary/20 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-4">
              <p class="font-heading font-semibold text-white text-sm leading-tight">{d.name}</p>
              <p class="text-white/70 text-xs mt-0.5 flex items-center gap-1">
                <MapPin class="w-3 h-3 text-accent" /> {d.area}
              </p>
            </div>
          </a>
        ))}
      </div>

      <div class="flex justify-center mt-10">
        <a href="/destinasi" data-route="destinations"
           class="inline-flex items-center gap-2 font-heading font-semibold text-primary text-sm border-b-2 border-accent pb-1 hover:gap-3 transition-all">
          {t('jaringan.lihatSemua')}
          <ArrowRight class="w-4 h-4" />
        </a>
      </div>
    </div>
  </section>

</div>
