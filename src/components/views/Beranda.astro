---
import ChevronLeft from '@lucide/astro/icons/chevron-left';
import ChevronRight from '@lucide/astro/icons/chevron-right';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import MapPin from '@lucide/astro/icons/map-pin';
import Sunrise from '@lucide/astro/icons/sunrise';
import Ticket from '@lucide/astro/icons/ticket';
import Sparkles from '@lucide/astro/icons/sparkles';
import RatingBadge from '../RatingBadge.astro';
import { DESTINATIONS, HERO_SLIDES, PACKAGES, EYE_TARIFFS, rupiah, localSrc } from '../../lib/data.js';
import { formatPrice } from '../../lib/i18n.js';

const { ratings = {}, class: cls = 'view' } = Astro.props;
const locale = Astro.locals.locale ?? 'id';
const t = key => Astro.locals.t(key);
const headline = ratings['nimo-highland'] ?? null;

const facilitiesTop = locale === 'en'
  ? ['Restaurant', 'Sky Bridge', 'Bean Bag & Net Area', 'Glass Sky Bridge', 'Flying Fox', 'F&B Stand', 'Souvenir Shop']
  : ['Restaurant', 'Sky Bridge', 'Bean Bag & Net Area', 'Glass Sky Bridge', 'Flying Fox', 'F&B Stand', 'Souvenir Shop'];
const facilitiesBottom = locale === 'en'
  ? ['Nimo Zoo', 'Food Court', 'Souvenir Shop', 'Mushola', 'Playground', 'Parking', 'Toilet', 'Local Shuttle']
  : ['Nimo Zoo', 'Food Court', 'Souvenir Shop', 'Musholla', 'Playground', 'Parkir', 'Toilet', 'Shuttle lokal'];

const regular = PACKAGES.find(p => p.id === 'regular');
const priceTables = [
  {
    label: t('booking.domestik'),
    rows: [
      [`${t('booking.dewasa')} · Weekday`, formatPrice(regular.price.domestik.adult[0], 'IDR', locale)],
      [`${t('booking.dewasa')} · Weekend`, formatPrice(regular.price.domestik.adult[1], 'IDR', locale)],
      [`${t('booking.anak')} · Weekday`, formatPrice(regular.price.domestik.child[0], 'IDR', locale)],
      [`${t('booking.anak')} · Weekend`, formatPrice(regular.price.domestik.child[1], 'IDR', locale)],
    ],
  },
  {
    label: t('booking.mancanegara'),
    rows: [
      [`${t('booking.dewasa')} · Weekday`, formatPrice(regular.price.manca.adult[0], 'IDR', locale)],
      [`${t('booking.dewasa')} · Weekend`, formatPrice(regular.price.manca.adult[1], 'IDR', locale)],
      [`${t('booking.anak')} · Weekday`, formatPrice(regular.price.manca.child[0], 'IDR', locale)],
      [`${t('booking.anak')} · Weekend`, formatPrice(regular.price.manca.child[1], 'IDR', locale)],
    ],
  },
  {
    label: 'Nimo Eye · Bianglala',
    rows: EYE_TARIFFS.map(([name, value]) => [name, formatPrice(value, 'IDR', locale)]),
    note: locale === 'en'
      ? 'Regular cabin 4 pax, 1 rotation ± 10 minutes. Tallest ferris wheel in Indonesia (MURI record).'
      : 'Kabin regular 4 pax, 1 putaran ± 10 menit. Bianglala tertinggi di Indonesia (rekor MURI).',
  },
];
---
<div class={cls} data-view="beranda">

  <!-- ============ HERO ============ -->
  <section class="relative min-h-[100svh] flex items-end overflow-hidden bg-bark">
    <div id="heroTrack" class="absolute inset-0">
      {HERO_SLIDES.map((s, i) => (
        <div class:list={['hero-slide absolute inset-0', i === 0 && 'active']}>
          <div class="img-shell absolute inset-0">
            <img class="w-full h-full object-cover" alt=""
                 src={i === 0 ? localSrc(s.fb) : localSrc(s.img)} data-fallback={localSrc(s.fb)}
                 fetchpriority={i === 0 ? 'high' : undefined} loading={i === 0 ? 'eager' : 'lazy'} />
          </div>
        </div>
      ))}
    </div>

    {/* Flat scrim instead of the old three-stop gradient. */}
    <div class="absolute inset-0 bg-bark/55 pointer-events-none"></div>

    <button id="heroPrev" type="button" aria-label="Previous slide"
            class="absolute left-3 sm:left-6 top-1/2 -translate-y-1/2 z-20 w-11 h-11 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 flex items-center justify-center text-white transition-colors">
      <ChevronLeft class="w-5 h-5" />
    </button>
    <button id="heroNext" type="button" aria-label="Next slide"
            class="absolute right-3 sm:right-6 top-1/2 -translate-y-1/2 z-20 w-11 h-11 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 flex items-center justify-center text-white transition-colors">
      <ChevronRight class="w-5 h-5" />
    </button>

    <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 lg:px-10 pb-16 lg:pb-24 w-full">
      <p class="eyebrow text-white/80 mb-4">
        <MapPin class="w-4 h-4" /> {t('hero.lokasi')}
      </p>
      <h1 class="font-heading font-bold text-white text-4xl sm:text-6xl lg:text-7xl leading-[1.05] max-w-3xl">
        Nimo Land Group
      </h1>

      <div class="flex flex-wrap items-center gap-4 mt-3">
        <p class="font-heading text-white/85 text-lg sm:text-2xl italic">{t('hero.tagline')}</p>
      </div>

      <p class="text-white/80 text-sm sm:text-base leading-relaxed max-w-xl mt-6">
        {t('hero.deskripsi')}
      </p>

      <div class="flex flex-wrap items-center gap-4 mt-8">
        <button type="button" data-open-booking="ticket" class="btn-accent px-7 py-3.5 sm:text-base">
          <Ticket class="w-4 h-4" /> {t('hero.beliTiketSekarang')}
          <ArrowRight class="w-4 h-4" />
        </button>
        <a href="/penginapan" data-route="hotels"
           class="inline-flex items-center gap-2 text-white/90 font-heading text-sm sm:text-base border-b border-white/40 hover:border-white pb-1 transition-colors">
          {t('hero.lihatPenginapan')}
        </a>
      </div>
      <div id="heroDots" class="flex items-center gap-2 mt-10"></div>
    </div>
  </section>

  <!-- ============ TENTANG ============ -->
  <section id="tentang" class="bg-surface py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div class="reveal">
          <p class="eyebrow text-sage-deep mb-4">
            <span class="w-6 h-px bg-sage"></span> {t('tentang.eyebrow')}
          </p>
          <h2 class="font-heading font-bold text-ink text-3xl sm:text-4xl lg:text-5xl leading-tight max-w-lg">
            {t('tentang.judul')}
          </h2>

          {headline && (
            <div class="flex items-center gap-3 mt-5">
              <RatingBadge rating={headline} size="lg" />
              {headline.source && (
                <span class="text-xs text-muted">Rating resmi · {headline.source}</span>
              )}
            </div>
          )}

          <p class="text-muted text-sm sm:text-base leading-relaxed mt-6 max-w-lg">
            {t('tentang.paragraf1')}
          </p>
          <p class="text-muted text-sm sm:text-base leading-relaxed mt-4 max-w-lg">
            {t('tentang.paragraf2')}
          </p>

          <div class="grid grid-cols-3 gap-4 mt-10 max-w-md">
            <div class="border-l-2 border-sage pl-4">
              <p class="font-heading font-bold text-ink text-2xl">10+</p>
              <p class="text-xs text-muted mt-1">{t('tentang.panorama')}</p>
            </div>
            <div class="border-l-2 border-sage pl-4">
              <p class="font-heading font-bold text-ink text-2xl">6+</p>
              <p class="text-xs text-muted mt-1">{t('tentang.wahana')}</p>
            </div>
            <div class="border-l-2 border-sage pl-4">
              <p class="font-heading font-bold text-ink text-2xl">5</p>
              <p class="text-xs text-muted mt-1">{t('tentang.buka')}</p>
            </div>
          </div>

          <a href="/destinasi" data-route="destinations"
             class="inline-flex items-center gap-2 font-heading font-semibold text-sage-deep text-sm mt-10 border-b-2 border-sage pb-1 hover:gap-3 transition-all">
            {t('tentang.selengkapnya')}
            <ArrowRight class="w-4 h-4" />
          </a>
        </div>

        <div class="relative reveal">
          <div id="momentSlider" class="relative aspect-[4/5] sm:aspect-[5/4] lg:aspect-[4/5] rounded-2xl overflow-hidden img-shell"></div>
          <div class="hidden sm:flex absolute -bottom-6 -left-6 card px-5 py-4 items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-sage-tint flex items-center justify-center shrink-0">
              <Sunrise class="w-5 h-5 text-sage-deep" />
            </div>
            <div>
              <p class="font-heading font-bold text-ink text-sm">{locale === 'en' ? 'Nationwide Network' : 'Jaringan Nasional'}</p>
              <p class="text-xs text-muted">{locale === 'en' ? 'Bandung · Subang · Malang · Toba · Sulawesi' : 'Bandung · Subang · Malang · Toba · Sulawesi'}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ JARINGAN DESTINASI ============ -->
  <section id="jaringan" class="bg-paper py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-10 reveal">
        <div>
          <p class="eyebrow text-sage-deep mb-4">
            <span class="w-6 h-px bg-sage"></span> {t('jaringan.eyebrow')}
          </p>
          <h2 class="font-heading font-bold text-ink text-3xl sm:text-4xl lg:text-5xl leading-tight max-w-lg">
            {t('jaringan.judul')}
          </h2>
        </div>
        <p class="text-muted text-sm max-w-sm">
          {t('jaringan.desc')}
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
        {DESTINATIONS.map(d => (
          <a href={`/destinasi/${d.id}`} data-route="destinations"
             class="group relative aspect-[4/3] rounded-xl overflow-hidden img-shell reveal">
            <img class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                 src={d.img} data-fallback={d.fb} alt={d.name} loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-bark/80 via-bark/20 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-4">
              <p class="font-heading font-semibold text-white text-sm leading-tight">{d.name}</p>
              <p class="text-white/60 text-xs mt-0.5 flex items-center gap-1">
                <MapPin class="w-3 h-3" /> {d.area}
              </p>
            </div>
          </a>
        ))}
      </div>

      <div class="flex justify-center mt-10">
        <a href="/destinasi" data-route="destinations"
           class="inline-flex items-center gap-2 font-heading font-semibold text-sage-deep text-sm border-b-2 border-sage pb-1 hover:gap-3 transition-all">
          {t('jaringan.lihatSemua')}
          <ArrowRight class="w-4 h-4" />
        </a>
      </div>
    </div>
  </section>

  <!-- ============ WAHANA ============ -->
  <section id="wahana" class="bg-paper py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-10 reveal">
        <div>
          <p class="eyebrow text-sage-deep mb-4">
            <span class="w-6 h-px bg-sage"></span> {t('wahana.eyebrow')}
          </p>
          <h2 class="font-heading font-bold text-ink text-3xl sm:text-4xl lg:text-5xl leading-tight max-w-lg">
            {t('wahana.judul')}
          </h2>
        </div>
        <p class="text-muted text-sm max-w-sm">
          {t('wahana.desc')}
        </p>
      </div>

      <div id="filterTabs" class="flex flex-wrap gap-3 mb-4" role="group" aria-label="Filter"></div>
      <p id="filterCount" class="text-xs text-muted mb-8" aria-live="polite"></p>
      <div id="wahanaGrid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5"></div>
      <p id="wahanaEmpty" class="hidden text-center text-muted text-sm py-12">{t('wahana.kosong')}</p>
    </div>
  </section>

  <!-- ============ TIKET ============ -->
  <section id="tiket" class="bg-bark py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
      <div class="max-w-2xl mb-14 reveal">
        <p class="eyebrow text-white/70 mb-4">
          <span class="w-6 h-px bg-white/40"></span> {t('tiket.eyebrow')}
        </p>
        <h2 class="font-heading font-bold text-white text-3xl sm:text-4xl lg:text-5xl leading-tight">{t('tiket.judul')}</h2>
        <p class="text-white/65 text-sm sm:text-base mt-4">
          {t('tiket.desc')}
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {priceTables.map(t => (
          <div class="bg-white/5 border border-white/10 rounded-2xl p-7">
            <p class="text-white/70 font-heading font-medium uppercase text-xs tracking-widest mb-4">{t.label}</p>
            <ul class="text-sm divide-y divide-white/10">
              {t.rows.map(([name, price]) => (
                <li class="flex justify-between py-2.5">
                  <span class="text-white/60">{name}</span>
                  <span class="text-white font-medium">{price}</span>
                </li>
              ))}
            </ul>
            {t.note && <p class="text-xs text-white/45 mt-4 leading-relaxed">{t.note}</p>}
          </div>
        ))}
      </div>

      <div class="flex justify-center mt-12">
        <button type="button" data-open-booking="ticket" class="btn-accent px-8 py-3.5 sm:text-base">
          <Ticket class="w-4 h-4" /> {t('tiket.pesanOnline')}
          <ArrowRight class="w-4 h-4" />
        </button>
      </div>
    </div>
  </section>

  <!-- ============ FASILITAS ============ -->
  <section id="fasilitas" class="bg-canvas py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
      <div class="mb-12 reveal">
        <p class="eyebrow text-sage-deep mb-4">
          <span class="w-6 h-px bg-sage"></span> {t('fasilitas.eyebrow')}
        </p>
        <h2 class="font-heading font-bold text-ink text-3xl sm:text-4xl lg:text-5xl leading-tight max-w-lg">
          {t('fasilitas.judul')}
        </h2>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        {[[t('fasilitas.atas'), facilitiesTop, 'bg-sage'], [t('fasilitas.bawah'), facilitiesBottom, 'bg-clay']].map(
          ([title, items, dot]) => (
            <div class="card p-7 reveal">
              <h3 class="font-heading font-semibold text-ink text-lg mb-5">{title}</h3>
              <ul class="grid grid-cols-2 gap-y-3 gap-x-4 text-sm text-muted">
                {items.map(f => (
                  <li class="flex items-center gap-2">
                    <span class:list={['w-1.5 h-1.5 rounded-full shrink-0', dot]}></span>{f}
                  </li>
                ))}
              </ul>
            </div>
          ),
        )}
      </div>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section id="faq" class="bg-surface py-20 lg:py-28">
    <div class="max-w-3xl mx-auto px-5 sm:px-8 lg:px-10">
      <div class="text-center mb-12 reveal">
        <p class="eyebrow text-sage-deep mb-4 justify-center">
          <Sparkles class="w-4 h-4" /> {t('faq.eyebrow')}
        </p>
        <h2 class="font-heading font-bold text-ink text-3xl sm:text-4xl lg:text-5xl leading-tight">
          {t('faq.judul')}
        </h2>
      </div>
      <div id="faqList" class="space-y-3"></div>
    </div>
  </section>
</div>
