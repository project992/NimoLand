---
import Ticket from '@lucide/astro/icons/ticket';
import BrandIcon from './BrandIcon.astro';
const t = key => Astro.locals.t(key);
---
<div class="fixed right-4 sm:right-6 bottom-5 sm:bottom-8 z-40 flex flex-col items-end gap-3">
  <a href="https://wa.me/6281111121162" target="_blank" rel="noopener" aria-label="WhatsApp"
     class="flex items-center gap-2 bg-sage hover:bg-sage-deep text-white font-heading font-semibold text-sm pl-4 pr-5 py-3 rounded-full transition-colors"
     style="box-shadow: var(--shadow-lift)">
    <BrandIcon name="whatsapp" class="w-5 h-5" />
    <span class="hidden sm:inline">WhatsApp</span>
  </a>
  <button type="button" data-open-booking="ticket" aria-label="Ticket"
          class="flex items-center gap-2 bg-clay hover:bg-clay-deep text-white font-heading font-bold text-sm pl-4 pr-5 py-3.5 rounded-full transition-colors"
          style="box-shadow: var(--shadow-lift)">
    <Ticket class="w-5 h-5" />
    {t('nav.beliTiket')}
  </button>
</div>
