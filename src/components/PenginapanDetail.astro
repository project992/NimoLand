---
import MapPin from '@lucide/astro/icons/map-pin';
import BedDouble from '@lucide/astro/icons/bed-double';
import Wifi from '@lucide/astro/icons/wifi';
import ArrowLeft from '@lucide/astro/icons/arrow-left';
import MessageCircle from '@lucide/astro/icons/message-circle';
import BrandIcon from './BrandIcon.astro';
import NimoImage from './NimoImage.astro';
import { rupiah, FOOTAGE } from '../lib/data.js';

/* Server-rendered detail view for /penginapan/[slug]. `.view` + data-view
   contract keeps the client Router able to navigate the whole app. */
const { h } = Astro.props;
const contactable = h.rooms.length === 0 || h.rooms.some(r => r.rate == null);
const from = h.rooms.filter(r => r.rate != null).map(r => r.rate).sort((a, b) => a - b)[0];
const video = FOOTAGE[h.id]?.aerial;
---
<div class="view active" data-view="item-detail">
  <section class="bg-bark pt-32 pb-16 lg:pt-40 lg:pb-20">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
      <a href="/penginapan" data-route="hotels"
         class="inline-flex items-center gap-2 text-white/70 hover:text-white text-sm font-heading mb-8 transition-colors">
        <ArrowLeft class="w-4 h-4" /> Semua penginapan
      </a>
      <div class="flex flex-wrap items-center gap-4">
        <p class="eyebrow text-white/70 mb-0">
          <span class="w-6 h-px bg-white/40"></span> {h.area}
        </p>
      </div>
      <h1 class="font-heading font-bold text-white text-4xl sm:text-5xl lg:text-6xl leading-tight max-w-3xl mt-4">
        {h.name}
      </h1>
      <p class="text-white/65 text-sm sm:text-base mt-5 max-w-xl">
        {h.desc}
      </p>
    </div>
  </section>

  <section class="bg-canvas py-14 lg:py-20">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
      <div class="grid lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2">
          <h2 class="font-heading font-semibold text-ink text-xl mb-4">Tipe Kamar</h2>
          {h.rooms.length === 0 ? (
            <div class="card p-7 text-center">
              <p class="font-heading font-semibold text-ink text-lg">Reservasi via Tim Kami</p>
              <p class="text-muted text-sm leading-relaxed mt-2 max-w-md mx-auto">
                Daftar kamar dan tarif belum dipublikasikan. Hubungi tim reservasi untuk ketersediaan kamar.
              </p>
              <a href={`https://wa.me/${"6281111121162"}`} target="_blank" rel="noopener"
                 class="btn-accent inline-flex items-center gap-2 mt-6 px-6 py-3.5">
                <MessageCircle class="w-4 h-4" /> Chat Reservasi
              </a>
            </div>
          ) : (
            <div class="grid sm:grid-cols-2 gap-5">
              {h.rooms.map(r => (
                <article class="card overflow-hidden flex flex-col">
                  <div class="aspect-[16/10] img-shell overflow-hidden">
                    <NimoImage remote={r.img} alt={`${h.name} — ${r.name}`} fill sizes="(min-width:1024px) 40vw, 100vw" />
                  </div>
                  <div class="p-5 flex flex-col flex-1">
                    <div class="flex items-start justify-between gap-3">
                      <p class="font-heading font-bold text-ink">{r.name}</p>
                      <span class="text-[11px] font-heading uppercase tracking-wider text-sage-deep bg-sage-tint px-2.5 py-1 rounded-full">{r.type}</span>
                    </div>
                    <p class="text-xs text-muted flex items-center gap-1.5 mt-2">
                      <BedDouble class="w-3.5 h-3.5" /> Kapasitas {r.cap} orang
                    </p>
                    <p class="text-sm text-muted leading-relaxed mt-3 flex-1">{r.desc}</p>
                    <p class="font-heading font-semibold text-ink mt-4">
                      {r.rate ? rupiah(r.rate) + '/malam' : 'Hubungi reservasi'}
                    </p>
                  </div>
                </article>
              ))}
            </div>
          )}
        </div>

        <aside class="space-y-5 lg:sticky lg:top-28 lg:self-start">
          <div class="card p-6">
            <p class="font-heading font-semibold text-ink text-lg">Fasilitas</p>
            <ul class="mt-3 space-y-2 text-sm text-muted">
              {h.facilities.map(f => (
                <li class="flex items-center gap-2">
                  <Wifi class="w-4 h-4 text-sage-deep shrink-0" /> {f}
                </li>
              ))}
            </ul>
          </div>
          <div class="card p-6">
            <p class="font-heading font-semibold text-sm text-muted">Harga mulai</p>
            <p class="font-heading font-bold text-ink text-2xl mt-1">
              {from ? rupiah(from) + '/malam' : 'Hubungi reservasi'}
            </p>
            {contactable && (
              <p class="text-xs text-muted mt-2">
                Tarif kamar belum dipublikasikan semua — hubungi tim reservasi untuk pemesanan.
              </p>
            )}
            <button type="button" data-open-booking="room" class="btn-accent w-full py-3.5 mt-5">
              Booking Kamar
            </button>
            <p class="text-xs text-muted mt-4 flex items-center gap-1.5 leading-relaxed">
              <MapPin class="w-3.5 h-3.5 shrink-0 mt-px" /> {h.area}
            </p>
          </div>
        </aside>
      </div>

      {h.facilityImages?.length > 0 && (
        <div class="mt-12">
          <h2 class="font-heading font-semibold text-ink text-xl mb-4">Galeri Fasilitas</h2>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
            {h.facilityImages.map(f => (
              <figure class="card overflow-hidden">
                <div class="aspect-[16/10] img-shell overflow-hidden">
                  <NimoImage remote={f.img} alt={`${h.name} — ${f.label}`} fill sizes="(min-width:1024px) 30vw, 50vw" />
                </div>
                <figcaption class="p-3 text-sm font-heading text-ink">{f.label}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      )}

      {video && (
        <div class="mt-12">
          <h2 class="font-heading font-semibold text-ink text-xl mb-4">Video / Suasana</h2>
          <div class="rounded-2xl overflow-hidden img-shell aspect-video bg-bark">
            <video class="w-full h-full object-cover" src={video} playsinline muted loop autoplay
                   controls preload="metadata" aria-label={`Video ${h.name}`}></video>
          </div>
        </div>
      )}
    </div>
  </section>
</div>