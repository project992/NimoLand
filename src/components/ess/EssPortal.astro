---
import IdCard from '@lucide/astro/icons/id-card';
import LogIn from '@lucide/astro/icons/log-in';
import LogOut from '@lucide/astro/icons/log-out';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import Video from '@lucide/astro/icons/video';
import UserPlus from '@lucide/astro/icons/user-plus';
import { DESTINATIONS } from '../../lib/data.js';

/* Employee Self-Service: login modal, dashboard overlay, data management.

   Login now POSTs to /api/ess/login (rate limited, scrypt-hashed, HTTP-only
   session cookie). The old flow compared a plain-text password column in the
   browser using the public anon key. */

const employee = Astro.locals.isEmployee ? Astro.locals.user : null;
const standalone = Astro.props.standalone === true;
const isEssAdmin = employee?.kind === 'employee' && (employee?.name || '').trim().toLowerCase() === 'ami';
---
<!-- ============ LOGIN ESS ============ -->
<div id="essLoginModal" class:list={[
  'fixed inset-0 z-96 bg-bark/50 p-0 sm:p-4 overflow-y-auto',
  !standalone && 'hidden',                    // standalone: tampil sebagai halaman
  standalone && !employee && 'flex items-center justify-center',
]}
     role="dialog" aria-modal="true" aria-labelledby="essLoginTitle">
  <div class="bg-surface sm:rounded-2xl w-full sm:max-w-md mx-auto min-h-full sm:min-h-0 sm:my-10 sm:shadow-lg overflow-hidden">
    {/* Solid header — was a two-stop gradient. */}
    <div class="bg-bark px-6 py-6">
      <div class="flex items-center gap-2">
        <span class="font-heading font-bold text-white text-lg tracking-wide">NIMO</span>
        <span class="text-white/60 text-[10px] font-medium uppercase tracking-widest border-l border-white/25 pl-2.5">Land Group</span>
      </div>
      <h3 id="essLoginTitle" class="font-heading font-bold text-white text-xl mt-3 flex items-center gap-2">
        <IdCard class="w-5 h-5" /> Portal ESS Karyawan
      </h3>
      <p class="text-white/65 text-xs mt-1">Employee Self-Service · Masuk untuk mengelola data</p>
    </div>

    <form id="essLoginForm" class="px-6 py-6" novalidate>
      <label for="essNik" class="label">NIK Karyawan</label>
      <input type="text" id="essNik" name="nik" autocomplete="username" placeholder="Masukkan NIK" class="field mb-4" />

      <label for="essPassword" class="label">Password</label>
      <input type="password" id="essPassword" name="password" autocomplete="current-password"
             placeholder="Masukkan password" class="field mb-3" />

      <p id="essLoginError" class="hidden note-error mb-4" role="alert"></p>

      <button type="submit" id="essLoginBtn" class="btn-primary w-full py-3.5">
        <LogIn class="w-4 h-4" /> Masuk Portal
      </button>
      <button type="button" data-close-ess class="btn-outline w-full mt-3 py-3.5">Batal</button>

      <p class="flex items-start gap-2 text-[11px] text-muted mt-4">
        <ShieldCheck class="w-4 h-4 shrink-0 mt-px text-sage" />
        Percobaan masuk dibatasi 5 kali per menit. Password diverifikasi di server.
      </p>
    </form>
  </div>
</div>

<!-- ============ DASHBOARD ESS ============ -->
<div id="essDashboard" class:list={['fixed inset-0 z-97 bg-canvas overflow-y-auto', !employee && 'hidden']}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">

    <div class="flex items-center justify-between gap-4 flex-wrap">
      <div class="flex items-center gap-2">
        <span class="font-heading font-bold text-ink text-lg tracking-wide">NIMO</span>
        <span class="text-sage-deep text-[10px] font-medium uppercase tracking-widest border-l border-line pl-2">ESS Dashboard</span>
      </div>
      <div class="flex items-center gap-3">
        <span class="hidden sm:inline text-xs text-muted">Sesi aktif sebagai</span>
        <div class="flex items-center gap-2.5 card rounded-full pl-1.5 pr-4 py-1.5">
          <div id="essAvatar" class="w-8 h-8 rounded-full bg-sage text-white flex items-center justify-center font-heading font-bold text-sm">
            {employee ? employee.name.trim().charAt(0).toUpperCase() : '—'}
          </div>
          <div class="leading-tight">
            <p id="essProfileName" class="font-heading font-semibold text-ink text-sm">{employee?.name ?? '—'}</p>
            <p id="essProfileMeta" class="text-[11px] text-muted">
              {employee ? `${employee.nik} · ${employee.role}` : '—'}
            </p>
          </div>
        </div>
        <button type="button" id="essLogoutBtn"
                class="inline-flex items-center gap-2 border border-danger/30 text-danger font-heading font-semibold text-xs px-4 py-2.5 rounded-full hover:bg-danger-tint transition-colors">
          <LogOut class="w-3.5 h-3.5" /> Logout
        </button>
      </div>
    </div>

    <!-- ============ EDITOR VIDEO DESTINASI ============ -->
    <div class="card p-6 mt-6">
      <div class="flex items-start gap-3">
        <div class="w-10 h-10 rounded-xl bg-sage-tint flex items-center justify-center shrink-0">
          <Video class="w-5 h-5 text-sage-deep" />
        </div>
        <div class="flex-1 min-w-0">
          <h2 class="font-heading font-bold text-ink text-lg">Video Destinasi</h2>
          <p class="text-xs text-muted mt-0.5">
            Ganti foto sampul sebuah destinasi menjadi video (mp4/webm) yang bisa dilihat semua pengunjung.
            Kosongkan URL lalu simpan untuk kembali ke foto.
          </p>
        </div>
      </div>

      <form id="essVideoForm" class="flex flex-col sm:flex-row gap-3 mt-5" novalidate>
        <label for="essVideoDest" class="sr-only">Pilih destinasi</label>
        <select id="essVideoDest" class="field rounded-xl sm:w-64" required>
          <option value="">Pilih destinasi…</option>
          {DESTINATIONS.map(d => <option value={d.id}>{d.name}</option>)}
        </select>
        <label for="essVideoUrl" class="sr-only">URL video</label>
        <input type="url" id="essVideoUrl" placeholder="https://…/video.mp4" class="field flex-1" />
        <button type="submit" class="btn-primary whitespace-nowrap">Simpan Video</button>
        <button type="button" id="essVideoClear" class="btn-outline whitespace-nowrap">Hapus</button>
      </form>
      <p id="essVideoNote" class="text-[11px] text-muted mt-3" aria-live="polite"></p>
      <p id="essVideoError" class="hidden note-error mt-3 mb-0" role="alert"></p>
    </div>

    <!-- ============ KELOLA AKUN ESS (khusus Ami) ============ -->
    <div id="essAccountsPanel" class:list=['card p-6 mt-5', !isEssAdmin && 'hidden']>
      <div class="flex items-start gap-3">
        <div class="w-10 h-10 rounded-xl bg-sage-tint flex items-center justify-center shrink-0">
          <UserPlus class="w-5 h-5 text-sage-deep" />
        </div>
        <div class="flex-1 min-w-0">
          <h2 class="font-heading font-bold text-ink text-lg">Kelola Akun ESS</h2>
          <p class="text-xs text-muted mt-0.5">
            Buat atau hapus akun karyawan (NIK, password, role). Khusus akun Ami.
          </p>
        </div>
      </div>

      <form id="essAccountForm" class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-5" novalidate>
        <label for="essAccNik" class="sr-only">NIK</label>
        <input type="text" id="essAccNik" placeholder="NIK karyawan (mis. NIK-0002)" class="field" autocomplete="off" />
        <label for="essAccName" class="sr-only">Nama</label>
        <input type="text" id="essAccName" placeholder="Nama lengkap" class="field" autocomplete="off" />
        <label for="essAccRole" class="sr-only">Role</label>
        <select id="essAccRole" class="field">
          <option value="">Pilih role…</option>
          <option value="Supervisor">Supervisor</option>
          <option value="Manager">Manager</option>
          <option value="Admin">Admin</option>
          <option value="Owner">Owner</option>
          <option value="Direktur">Direktur</option>
        </select>
        <label for="essAccPassword" class="sr-only">Password</label>
        <input type="password" id="essAccPassword" placeholder="Password (min. 8 karakter)" class="field" autocomplete="new-password" />
        <button type="submit" id="essAccountBtn" class="btn-primary sm:col-span-2">Tambah Akun</button>
      </form>
      <p id="essAccountError" class="hidden note-error mt-3 mb-0" role="alert"></p>

      <div class="mt-6">
        <h3 class="font-heading font-semibold text-ink text-sm mb-3">Daftar Akun</h3>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead>
              <tr class="bg-paper text-muted text-[11px] uppercase tracking-wider">
                <th scope="col" class="px-4 py-3 font-heading font-semibold whitespace-nowrap">NIK</th>
                <th scope="col" class="px-4 py-3 font-heading font-semibold">Nama</th>
                <th scope="col" class="px-4 py-3 font-heading font-semibold">Role</th>
                <th scope="col" class="px-4 py-3 font-heading font-semibold">Status</th>
                <th scope="col" class="px-4 py-3 font-heading font-semibold text-right">Aksi</th>
              </tr>
            </thead>
            <tbody id="essAccountBody" class="divide-y divide-line-soft"></tbody>
          </table>
        </div>
        <p id="essAccountEmpty" class="hidden text-center text-muted text-sm py-6">Belum ada akun.</p>
      </div>
    </div>

    <p id="essSyncNote" class="text-center text-[11px] text-muted mt-5" aria-live="polite"></p>
  </div>
</div>
