# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Supabase (server-side only) ---
# Project Settings -> API. The SERVICE ROLE key bypasses RLS and must never
# reach the browser. It is imported only from src/lib/supabase.js, which is
# used exclusively by src/pages/api/** and src/middleware.js.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Session signing ---
# Minimum 32 characters. Rotating this invalidates every existing session.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Deployment ---
# Set to 1 ONLY when the app runs behind a reverse proxy / load balancer that
# sets X-Forwarded-For. If it is 1 without a proxy, clients can forge their own
# IP and walk straight around the rate limiter.
TRUST_PROXY=0

# --- FASE 3: Payment gateway (Midtrans Snap) ---
# Server key TIDAK pernah dibundle ke frontend (hanya dipakai src/lib/midtrans.js).
# MIDTRANS_IS_PRODUCTION=1 memakai https://app.midtrans.com, selain itu sandbox.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=0

# --- FASE 3: E-tiket otomatis via email (Resend). Resend : satu opsi ringan
# tanpa SDK (fetch). Alternatif: ganti sendEmail() di src/lib/mailer.js dengan
# nodemailer + kredensial SMTP. Tanpa ini, e-tiket tetap bisa diunduh/dikirim WA
# dari halaman "Pesanan Saya".
RESEND_API_KEY=
RESEND_FROM=

# --- Deplyment domain, dipakai di body e-tiket email ---
SITE_URL=

# --- Seeding (optional, used by `npm run seed:employees`) ---
# NIK|Name|Role|password  ? separate multiple accounts with ;
SEED_EMPLOYEES=
